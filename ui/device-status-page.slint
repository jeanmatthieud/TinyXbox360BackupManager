import { ScrollView } from "std-widgets.slint";
import { UiState } from "ui-state.slint";
import { Message, Dispatcher } from "messages.slint";
import { TargetKind } from "types.slint";
import { PageHeader } from "components/page-header.slint";
import { NoTarget } from "components/no-target.slint";
import { DriveInfoCard } from "components/toolbox/drive-info-card.slint";
import {
    LibraryStorageCard,
} from "components/toolbox/library-storage-card.slint";
import { ConsoleCard } from "components/toolbox/console-card.slint";
import { AuroraScanPathsCard } from "components/toolbox/aurora-scan-paths-card.slint";
import { DashlaunchCard } from "components/toolbox/dashlaunch-card.slint";

// Health / storage report for the currently connected target.
export component DeviceStatusPage inherits VerticalLayout {
    init => {
        if !UiState.config.target.is-empty && !UiState.fetching-aurora-paths {
            Dispatcher.dispatch(Message.FetchAuroraPaths, "");
        }
        if !UiState.config.target.is-empty && !UiState.writing-dashlaunch {
            Dispatcher.dispatch(Message.FetchDashlaunch, "");
        }
    }

    PageHeader {
        title: "Device status";
    }

    if UiState.config.target.is-empty: NoTarget {
        description: "Connect a USB drive or your console to see its filesystem and storage folders";
    }

    if !UiState.config.target.is-empty: ScrollView {
        VerticalLayout {
            width: 100%;
            padding: 10px;
            padding-top: 0px;
            spacing: 10px;
            alignment: start;

            if UiState.config.target-kind == TargetKind.Ftp && !UiState.config.target.is-empty: ConsoleCard { }

            // A FATX drive reports its size and free space just like a mounted
            // one, so it gets the same card.
            if UiState.config.target-kind == TargetKind.Local || UiState.config.target-kind == TargetKind.Fatx: DriveInfoCard { }

            // App storage folders (and, on a console, their Aurora coverage).
            LibraryStorageCard { }

            // Aurora scan paths: always for a console; for a local drive only
            // when it carries an Aurora install (otherwise nothing to show).
            if !UiState.config.target.is-empty && (UiState.config.target-kind != TargetKind.Local || UiState.aurora-scan-paths.length > 0): AuroraScanPathsCard { }

            // Dashlaunch's launch.ini (XeUnshackle, RGH): only when the target
            // has one.
            if UiState.dashlaunch.found: DashlaunchCard { }
        }
    }
}

import { IconSet } from "@lucide";
import { CheckBox, ComboBox, Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { IconButton } from "../icon-button.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";

// Card offering to build a homebrew boot USB key. Always shown, but the action
// is disabled while a target is connected (the key must be built standalone).
export component BadAvatarCard inherits ToolboxCard {
    private property <bool> target-connected: !UiState.config.target.is-empty;

    // Nothing here is usable while the key is being built, while a target is
    // connected (the key must be prepared standalone)
    // — so veil the whole card rather than just its action row.
    disabled: UiState.creating-badavatar || UiState.compat-busy || UiState.badavatar-hdd-tool-busy || target-connected;
    disabled-tooltip: target-connected
        ? "Disconnect from the current target first"
        : UiState.compat-busy
            ? "Wait for the original Xbox compatibility install to finish."
            : UiState.badavatar-hdd-tool-busy
                ? "Wait for BadAvatar to be written to the hard drive."
                : "";

    CardHeader {
        icon: IconSet.Usb;
        title: "BadAvatar USB key";

        if UiState.creating-badavatar: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }

    }

    HorizontalLine { }

    Text {
        text: "Creates a homebrew boot USB key (ABadAvatar + XeUnshackle + Aurora).\nPlug in a FAT32-formatted USB key first.";
        wrap: word-wrap;
    }

    // Version picker for the ABadAvatar boot chain. Where each version is
    // downloaded from is set in the Settings page.
    HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Text {
                text: "ABadAvatar version:";
            }
        }

        ComboBox {
            height: 34px;
            horizontal-stretch: 1;
            model: UiState.badavatar.abadavatar-versions;
            // A ComboBox shows whatever `current-index` points at — assigning
            // `current-value` does NOT move the selection.
            current-index: UiState.badavatar.abadavatar-version-index;
            selected => {
                Dispatcher.dispatch(Message.SetBadAvatarVersion, self.current-index);
            }
        }
    }

    CheckBox {
        text: "Also download and add the official system update";
        checked: UiState.badavatar.include-system-update;
        toggled => {
            Dispatcher.dispatch(Message.ToggleBadAvatarSystemUpdate, "");
        }
    }

    CheckBox {
        text: "Auto start Aurora without delay (XeUnshackle Max)";
        checked: UiState.badavatar.xeunshackle-autostart;
        toggled => {
            Dispatcher.dispatch(Message.ToggleBadAvatarAutostart, "");
        }
    }

    HorizontalLine { }

    CardActionRow {
        icon: IconSet.Hammer;
        text: !UiState.creating-badavatar ? "Create the BadAvatar USB key" : "Working… see the status bar below.";
        // Opens the in-app removable-drive picker. Hidden escape hatch: a long
        // press falls back to the native folder picker (any arbitrary path).
        long-press-duration: 1500ms;
        clicked => Dispatcher.dispatch(Message.CreateBadAvatar, "");
        long-pressed => Dispatcher.dispatch(Message.PickBadAvatarMountPoint, "");
    }
}

import { IconSet } from "@lucide";
import { ToolboxCard } from "toolbox-card.slint";
import { CardHeader } from "card-header.slint";
import { HorizontalLine } from "horizontal-line.slint";
import { IconButton } from "icon-button.slint";
import { ABadAvatarUrlField, DownloadUrlField } from "download-url-field.slint";
import { BuiltinPackRow, CustomPackRow } from "compat-pack-rows.slint";
import { Message, Dispatcher } from "../messages.slint";
import { MyPalette } from "../styling.slint";
import { UiState } from "../ui-state.slint";

// Title of one tool's group of sources, with optional actions on the right.
component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    spacing: 5px;
    height: 27px;

    Text {
        text: root.text;
        font-weight: 600;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    @children
}

// Where the Toolbox tools download what they install: the ABadAvatar
// components, and the original-Xbox emulator packs with their per-title
// configs. Every ABadAvatar field falls back to a built-in release, and its
// reset button brings it back; the built-in emulator packs are fixed, and
// packs of the user's own come after them.
export component DownloadSourcesCard inherits ToolboxCard {
    // The tools read these when they start: changing them mid-run would
    // mislead, since the run in progress keeps the URLs it started with.
    disabled: UiState.creating-abadavatar || UiState.abadavatar-hdd-busy || UiState.compat-busy;
    disabled-tooltip: "Disponible lorsque l’outil en cours aura terminé.";

    CardHeader {
        icon: IconSet.Download;
        title: "Sources de téléchargement";
    }

    HorizontalLine { }

    Text {
        text: "Utilisateurs avancés : modifiez les adresses des packs avant de les télécharger et de les installer.";
        font-size: 12px;
        wrap: word-wrap;
        color: MyPalette.foreground.transparentize(0.35);
    }

    SectionTitle {
        text: "ABadAvatar";
    }

    ABadAvatarUrlField {
        label: "ABadAvatar 1.0-beta";
        url: UiState.abadavatar.abadavatar-v10-url;
        default-url: UiState.abadavatar.abadavatar-v10-default-url;
        field-key: "abadavatar_v10";
    }

    ABadAvatarUrlField {
        label: "ABadAvatar 1.3-beta (également utilisé sur disque dur)";
        url: UiState.abadavatar.abadavatar-v13-url;
        default-url: UiState.abadavatar.abadavatar-v13-default-url;
        field-key: "abadavatar_v13";
    }

    ABadAvatarUrlField {
        label: "XeUnshackle";
        url: UiState.abadavatar.xeunshackle-url;
        default-url: UiState.abadavatar.xeunshackle-default-url;
        field-key: "xeunshackle";
    }

    ABadAvatarUrlField {
        label: "XeUnshackle Max (démarrage d’Aurora sans délai)";
        url: UiState.abadavatar.xeunshackle-max-url;
        default-url: UiState.abadavatar.xeunshackle-max-default-url;
        field-key: "xeunshackle_max";
    }

    ABadAvatarUrlField {
        label: "Aurora";
        url: UiState.abadavatar.aurora-url;
        default-url: UiState.abadavatar.aurora-default-url;
        field-key: "aurora";
        sources: UiState.abadavatar.aurora-sources;
    }

    ABadAvatarUrlField {
        label: "Mise à jour système";
        url: UiState.abadavatar.system-update-url;
        default-url: UiState.abadavatar.system-update-default-url;
        field-key: "system_update";
    }

    HorizontalLine { }

    SectionTitle {
        text: "Rétrocompatibilité Xbox originale";

        // Only once there is something to take away.
        if UiState.compat-custom-packs.length > 0: IconButton {
            icon: IconSet.RotateCcw;
            label: "Rétablir les valeurs par défaut";
            font-size: 12px;
            horizontal-stretch: 0;
            tooltip: "Retirer les packs ajoutés";
            clicked => Dispatcher.dispatch(Message.ResetCompatPacks, "");
        }

        IconButton {
            icon: IconSet.Plus;
            label: "Ajouter un pack";
            font-size: 12px;
            horizontal-stretch: 0;
            clicked => Dispatcher.dispatch(Message.AddCompatPack, "");
        }
    }

    Text {
        text: "Les packs intégrés sont fixes ; vos packs apparaissent à leur suite dans les outils.";
        font-size: 12px;
        wrap: word-wrap;
        color: MyPalette.foreground.transparentize(0.35);
    }

    for pack in UiState.compat-builtin-packs: BuiltinPackRow {
        pack: pack;
    }

    for pack in UiState.compat-custom-packs: CustomPackRow {
        pack: pack;
    }

    // Sets the configs apart from the pack list: they are not a pack, and
    // would otherwise read as one more row of it.
    HorizontalLine { }

    DownloadUrlField {
        label: "Configurations par jeu";
        url: UiState.compat.configs-url;
        default-url: UiState.compat.configs-default-url;
        url-edited(url) => {
            Dispatcher.dispatch(Message.SetCompatConfigsUrl, url);
        }
        reset-requested => {
            Dispatcher.dispatch(Message.ResetCompatConfigsUrl, "");
        }
    }
}

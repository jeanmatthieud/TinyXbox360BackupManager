import { IconSet } from "@lucide";
import { EmptyState } from "empty-state.slint";
import { Message, Dispatcher } from "../messages.slint";

// Shown when the target has been scanned but holds no game yet: an
// invitation to add a first backup.
export component NoGames inherits EmptyState {
    boxed: true;
    icon: IconSet.Gamepad2;
    title: "No games yet";
    description: "Add an ISO or XBLA backup to get started";
    action-icon: IconSet.Plus;
    action-label: "Add a game";
    action => {
        Dispatcher.dispatch(Message.PickGames, "false");
    }
}

export enum Page {
    Games,
    Toolbox,
    DeviceStatus,
    Jobs,
    Settings,
    About,
}

// Family a queued job belongs to. Mirrors `JobKind` in the Rust core
// (crates/core/src/job_queue.rs), same order.
export enum JobKind {
    // Game added to the target: conversion/extraction then transfer.
    Add,
    // Installed game removed from the target.
    Delete,
    // One stored component (a disc package, a DLC file) removed from a game.
    DeleteContent,
}

// One entry of the job queue, as shown on the queue page.
export struct DisplayedJob {
    // Game/file this job works on.
    label: string,
    // Drives the row icon and the wording of the cancellation modals.
    kind: JobKind,
}

export enum TargetKind {
    Local,
    Ftp,
    // The console's own hard drive, connected to this computer and read
    // through its FATX filesystem.
    Fatx,
}

// How <TitleID> folders are arranged inside the GOD storage directory.
// Mirrors `GodLayout` in the Rust core (crates/core/src/config.rs); the
// variants must stay in the same order as the drop-down in
// components/storage-config-modal.slint.
export enum GodLayout {
    TitleId,
    NameSlashTitleId,
    NameDashTitleId,
    TitleIdDashName,
}

// Action the user asked for while the job queue was still busy: it is
// held back until the queue has been cancelled and fully drained.
export enum PendingQueueAction {
    None,
    Disconnect,
    Quit,
}

export struct DisplayedConfig {
    path: string,
    // Displayed target: local path or ftp://ip. Empty if no target.
    target: string,
    target-kind: TargetKind,
    mount-point: string,
    remove-sources-games: string,
    xbox360-format: string,
    sort-by: string,
    view-as: string,
    theme-preference: string,
    auto-reconnect: string,
    cover-source: string,
    show-x360: bool,
    show-arcade: bool,
    show-og: bool,
    console-ip: string,
    ftp-port: string,
    ftp-user: string,
    ftp-password: string,
}

// A known download source a URL field offers as a one-click alternative.
export struct DisplayedUrlSource {
    label: string,
    url: string,
    // Host the URL points at, shown under the label.
    host: string,
}

export struct DisplayedBadAvatarConfig {
    // Effective URLs (user override or built-in default) shown in the fields.
    abadavatar-v10-url: string,
    abadavatar-v13-url: string,
    xeunshackle-url: string,
    xeunshackle-max-url: string,
    aurora-url: string,
    system-update-url: string,
    // Built-in default URLs, so each field can offer a reset when it differs.
    abadavatar-v10-default-url: string,
    abadavatar-v13-default-url: string,
    xeunshackle-default-url: string,
    xeunshackle-max-default-url: string,
    aurora-default-url: string,
    system-update-default-url: string,
    // Known sources for Aurora, the default first.
    aurora-sources: [DisplayedUrlSource],
    include-system-update: bool,
    // USB key: install XeUnshackle Max, set to boot straight into Aurora,
    // instead of the stock XeUnshackle.
    xeunshackle-autostart: bool,
    // Labels of the ABadAvatar versions, in the drop-down's own order.
    abadavatar-versions: [string],
    // Row of the version the USB key uses in `abadavatar-versions`.
    abadavatar-version-index: int,
}

// What the FTP target modal is being opened for: connecting the app to a
// console, or just picking one for a Toolbox tool that does not change the
// current target.
export enum FtpPurpose {
    Connect,
    Compat,
}

// One emulator pack in the settings list: a built-in one (shown, not
// editable) or one the user added.
export struct DisplayedCompatPack {
    key: string,
    label: string,
    url: string,
}

export struct DisplayedCompatConfig {
    // Labels of the available XeFu packs, in the drop-down's own order.
    packs: [string],
    // Row of the chosen pack in `packs`.
    pack-index: int,
    // One line describing the chosen pack, shown under the drop-down.
    pack-description: string,
    // True when the chosen pack only runs on a JTAG/RGH/XDK console.
    needs-exploit: bool,
    // Where the per-title configs are downloaded from, and the built-in URL
    // so the field can offer a reset when the two differ.
    configs-url: string,
    configs-default-url: string,
    // Where the configs come from, as the Toolbox card names it.
    configs-source: string,
    backup-first: bool,
    // Also fetch the community per-title configs and write them next to the
    // emulator.
    update-configs: bool,
}

// Dashlaunch's `launch.ini` on the connected target (Device status page).
// See `txbm_core::dashlaunch`.
export struct DisplayedDashlaunch {
    // False until a launch.ini was found: the card stays hidden.
    found: bool,
    // Where it was found, as the user knows the path (`Usb0:\launch.ini`).
    location: string,
    // Content bought on another console: add-ons, Arcade games, license mask.
    contpatch: bool,
    xblapatch: bool,
    licpatch: bool,
    // Protections, shown read-only.
    liveblock: bool,
    noupdater: bool,
}

// BadAvatar on the connected console hard drive (Device status page, FATX
// target only). See `txbm_core::badavatar_hdd`.
export enum BadAvatarHddState {
    // Not read yet, or not a console hard drive: the card stays hidden.
    Unknown,
    // No trace of BadAvatar: an install is offered.
    Retail,
    // Installed by this app.
    Installed,
    // Installed by this app, but interrupted or altered since.
    Incomplete,
    // Someone else's setup: reported, never touched.
    Foreign,
}

export struct DisplayedBadAvatarHdd {
    state: BadAvatarHddState,
    // What makes a foreign drive non-retail, in console notation.
    found: [string],
    // What a removal deletes, in the order it does.
    removal: [string],
}

export struct DisplayedRecentLocation {
    // Folder name (local drive), IP (console over FTP) or device path (a
    // console hard drive connected here).
    name: string,
    kind: TargetKind,
}

// A raw disk offered in the FATX target picker. See `txbm_core::fatx_dev`.
export struct DisplayedFatxDrive {
    // Model / device name.
    name: string,
    // Raw device path, dispatched on selection.
    path: string,
    // Preformatted size, empty when unknown.
    size-text: string,
    // What probing the disk found ("Xbox 360 hard drive", "access denied…").
    detail: string,
    // True when the disk really holds an Xbox 360 filesystem; the others are
    // shown but disabled, so the user can see why they are not offered.
    usable: bool,
}

// A local drive offered in the target-selection modal: a removable device or
// any non-system disk. See `txbm_core::drives`.
export struct DisplayedRemovableDrive {
    // Volume label / mount name.
    name: string,
    // Mount root, used as the library location (dispatched on selection).
    mount-point: string,
    // Preformatted "X free of Y", empty when the size is unknown.
    size-text: string,
    // True when the OS flags the drive as removable (drives the shown icon).
    is-removable: bool,
    // Filesystem name ("FAT32", "exFAT", "NTFS", …).
    fs-label: string,
    // True only for FAT32: the sole filesystem the console reads. Non-FAT32
    // drives are shown but disabled.
    is-fat32: bool,
}

// One entry of the "add these conversions to the queue?" confirmation.
export struct DisplayedGameToAdd {
    // Source file name.
    name: string,
    // True when a game with the same TitleID is already installed on the
    // target: queueing this one overwrites it. Detected before the queue is
    // confirmed, from the already-scanned library (no extra I/O).
    already-installed: bool,
    // Title of the game it would overwrite, empty when `already-installed`
    // is false.
    installed-title: string,
}

export struct DisplayedGame {
    path: string,
    is-x360: bool,
    is-arcade: bool,
    format: string,
    size-gib: float,
    title: string,
    id: string,
    cover: image,
    // True when only DLC and/or a title update are installed, with no
    // actual game package (base install removed or never completed).
    incomplete: bool,
    // True while the running job writes into this game's folder — a second
    // disc or a DLC being added under its TitleID, or its own deletion. Its
    // size and contents are in flux, so the card is veiled and neither opens
    // its details nor offers a deletion of its own.
    busy: bool,
}

// Status of one stored component (disc / DLC / title update) shown in the
// game info modal's table.
export enum ComponentStatus {
    // Present and its STFS header parses cleanly.
    Installed,
    // STFS header couldn't be read (missing magic / interrupted upload).
    Corrupted,
    // Expected but absent (e.g. only DLC installed, base game disc missing).
    Missing,
    // Currently being transferred (reserved; wired up later).
    Uploading,
}

// One row of the game info modal's stored-components table.
export struct DisplayedGameComponent {
    // "Disc", "DLC", or "TU" — drives the row icon and label.
    kind: string,
    // On-disk file name of the package, used to delete it. Empty for the
    // synthetic "Missing" row (which has nothing to delete).
    id: string,
    // e.g. "Disc 1 · 545408A7" or the DLC display name.
    description: string,
    size-gib: float,
    status: ComponentStatus,
    // Tooltip of the lock icon when the package's license restricts it to
    // some consoles / profiles; empty when it plays anywhere.
    license-lock: string,
}

export struct DisplayedTitleUpdate {
    id: string,
    hash: string,
    name: string,
    version: string,
    size-text: string,
    // File name under 000B0000 when installed, empty otherwise.
    installed-file-name: string,
    is-active: bool,
    // True if Aurora already downloaded this update into its own cache
    // (the only case in which this app can activate it).
    is-cached: bool,
}

// One folder this app installs/scans on the console, and whether Aurora is
// configured to scan it (or an ancestor).
export struct DisplayedStoragePath {
    label: string,
    // FTP path (/Device/dir/…).
    path: string,
    // Same location in Aurora's "Manage Paths" format (Device:\dir\…).
    aurora-path: string,
    covered: bool,
}

export struct DisplayedDriveInfo {
    label: string,
    used-gib: float,
    games-gib: float,
    total-gib: float,
    fs-kind: string,
    allocation-granularity: int,
}

// Tone of a notification: picks its icon and accent colour.
export enum NotificationKind {
    Info,
    Success,
    Error,
    Warning,
}

export struct Notification {
    // Stable identity, handed out by the Rust side. Toasts dismiss themselves
    // by id rather than by row: several can time out in the same frame, and
    // the first removal would shift the others' indices.
    id: int,
    text: string,
    kind: NotificationKind,
    // Never times out on its own: the user has to close it. Errors are sticky
    // regardless of this flag; Warning, Info and Success honor it.
    sticky: bool,
}

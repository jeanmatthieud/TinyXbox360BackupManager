import { Modal } from "modal.slint";
import { ScrollView } from "std-widgets.slint";
import { HorizontalLine } from "horizontal-line.slint";
import { IconButton, IconButtonKind } from "icon-button.slint";
import { Icon, IconSet } from "@lucide";

export component ConfirmationModal inherits Modal {
    in property <bool> destructive: false;
    in property <Icon> btn-icon: IconSet.WifiZero;

    callback cancelled();
    callback confirmed();

    // spacing: 10px;

    ScrollView {
        width: min(v.preferred-width, root.max-w - 40px);
        height: min(v.preferred-height, 300px);
        // Only vertical scrolling here: a Text keeps the full unwrapped text as
        // preferred width, so leaving viewport-width unbound would let a long
        // message scroll sideways instead of wrapping.
        viewport-width: self.visible-width;

        v := VerticalLayout {
            alignment: start;
            padding: 20px;
            spacing: 5px;

            @children
        }
    }

    VerticalLayout {
        height: self.min-height;

        HorizontalLine { }

        HorizontalLayout {
            alignment: end;
            padding: 10px;
            spacing: 10px;

            IconButton {
                label: "Cancel";
                clicked => cancelled();
            }

            IconButton {
                label: "Ok";
                kind: destructive ? IconButtonKind.Destructive : IconButtonKind.Primary;
                icon: btn-icon;
                clicked => confirmed();
            }
        }
    }
}

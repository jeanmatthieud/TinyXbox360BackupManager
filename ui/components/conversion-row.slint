import { IconSet } from "@lucide";
import { IconButton } from "icon-button.slint";

export component ConversionRow inherits Rectangle {
    in property <string> label;
    // Reordering: the buttons are always shown so the rows stay aligned, and
    // are disabled at the ends of the list.
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;

    callback cancel();
    callback move-up();
    callback move-down();

    height: 28px;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 2px;
        spacing: 2px;
        cross-axis-alignment: CrossAxisAlignment.center;

        Text {
            horizontal-stretch: 1;
            text: label;
            overflow: elide;
            vertical-alignment: center;
        }

        IconButton {
            horizontal-stretch: 0;
            icon: IconSet.ChevronUp;
            tooltip: "Move up in the queue";
            disabled: !can-move-up;
            height: 24px;
            width: 24px;
            squared: true;
            clicked => move-up();
        }

        IconButton {
            horizontal-stretch: 0;
            icon: IconSet.ChevronDown;
            tooltip: "Move down in the queue";
            disabled: !can-move-down;
            height: 24px;
            width: 24px;
            squared: true;
            clicked => move-down();
        }

        IconButton {
            horizontal-stretch: 0;
            icon: IconSet.X;
            tooltip: "Remove from the queue";
            height: 24px;
            width: 24px;
            squared: true;
            clicked => cancel();
        }
    }
}

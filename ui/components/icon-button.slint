import { Icon, IconDisplay, IconSet } from "@lucide";
import { Palette } from "std-widgets.slint";
import { MyPalette } from "../styling.slint";
import { Card } from "card.slint";
import { TooltipArea } from "tooltip-area.slint";

export enum IconButtonKind {
    Primary,
    Secondary,
    Destructive,
    DestructiveText,
    DestructiveOutline,
}

export component IconButton inherits TooltipArea {
    in property <string> label;
    in property <Icon> icon: IconSet.WifiZero;
    in property <IconButtonKind> kind: IconButtonKind.Secondary;
    in property <bool> rounded: false;
    in property <bool> squared: false;
    in property <length> font-size: 14px;
    // Per-corner overrides, to let a button sitting flush against a rounded
    // container pick up that container's curve. Default to the shape `rounded`
    // / `squared` already give.
    in property <length> radius-top-left: get-radius();
    in property <length> radius-top-right: get-radius();
    in property <length> radius-bottom-left: get-radius();
    in property <length> radius-bottom-right: get-radius();

    pure function get-bg() -> brush {
        if kind == IconButtonKind.Primary {
            self.has-hover ? MyPalette.accent-background.darker(0.2) : MyPalette.accent-background
        } else if kind == IconButtonKind.Destructive {
            self.has-hover ? MyPalette.destructive.darker(0.2) : MyPalette.destructive;
        } else if kind == IconButtonKind.DestructiveText {
            transparent
        } else if kind == IconButtonKind.DestructiveOutline {
            self.has-hover ? MyPalette.destructive.transparentize(0.85) : transparent
        } else {
            self.has-hover ? MyPalette.alternate-background.darker(0.1) : MyPalette.alternate-background;
        }
    }

    pure function get-border-color() -> color {
        if kind == IconButtonKind.DestructiveText {
            self.has-hover ? MyPalette.destructive : transparent
        } else if kind == IconButtonKind.DestructiveOutline {
            MyPalette.destructive
        } else if kind == IconButtonKind.Secondary && !squared {
            MyPalette.border
        } else {
            transparent
        }
    }

    pure function get-border-width() -> length {
        if kind == IconButtonKind.DestructiveText {
            self.has-hover ? 1px : 0px
        } else if kind == IconButtonKind.DestructiveOutline {
            1px
        } else if kind == IconButtonKind.Secondary && !squared {
            1px
        } else {
            0px
        }
    }

    pure function get-stroke() -> brush {
        if kind == IconButtonKind.DestructiveText {
            self.has-hover ? MyPalette.destructive : MyPalette.foreground.transparentize(0.4)
        } else if kind == IconButtonKind.DestructiveOutline {
            MyPalette.destructive
        } else if kind == IconButtonKind.Secondary {
            MyPalette.foreground
        } else {
            MyPalette.accent-foreground
        }
    }

    pure function get-font-weight() -> int {
        if kind == IconButtonKind.Secondary || kind == IconButtonKind.DestructiveText {
            400
        } else {
            600
        }
    }

    pure function get-radius() -> length {
        if rounded {
            self.width / 2;
        } else if squared {
            0px
        } else {
            10px
        }
    }

    background: get-bg();
    border-color: get-border-color();
    border-width: get-border-width();
    border-top-left-radius: radius-top-left;
    border-top-right-radius: radius-top-right;
    border-bottom-left-radius: radius-bottom-left;
    border-bottom-right-radius: radius-bottom-right;
    height: 27px;

    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        padding-left: label.is-empty ? 0px : 10px;
        padding-right: label.is-empty ? 0px : 10px;
        cross-axis-alignment: CrossAxisAlignment.center;

        if icon != IconSet.WifiZero: VerticalLayout {
            alignment: center;

            IconDisplay {
                icon: icon;
                stroke: get-stroke();
                size: font-size;
            }
        }

        if !label.is-empty: Text {
            text: label;
            color: get-stroke();
            vertical-alignment: center;
            font-weight: get-font-weight();
            font-size: font-size;
        }
    }
}

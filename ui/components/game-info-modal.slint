import { ScrollView, ProgressIndicator, Palette } from "std-widgets.slint";
import { ComponentStatus, DisplayedGame, DisplayedGameComponent } from "../types.slint";
import { IconSet, IconDisplay, Icon } from "@lucide";
import { Link } from "link.slint";
import { Card } from "card.slint";
import { HorizontalLine } from "horizontal-line.slint";
import { MyPalette } from "../styling.slint";
import { IconButton, IconButtonKind } from "icon-button.slint";
import { TooltipArea } from "tooltip-area.slint";
import { Modal } from "modal.slint";
import { CoverImage } from "cover-image.slint";
import { UiState } from "../ui-state.slint";
import { Message, Dispatcher } from "../messages.slint";

// One table row for a stored component, with a trash button revealed on hover
// (except for the synthetic "Missing" row, which has nothing to delete).
component ContentRow inherits Rectangle {
    in property <DisplayedGameComponent> comp;
    in property <length> col-kind;
    in property <length> col-size;
    in property <length> col-status;
    callback delete-requested();

    // Rows without a stored file name (the synthetic "Missing" and "Game"
    // rows) have nothing to delete on their own.
    property <bool> deletable: comp.id != "";

    pure function kind-icon(k: string) -> Icon {
        if k == "DLC" {
            IconSet.Gift
        } else if k == "TU" {
            IconSet.RefreshCw
        } else if k == "Game" {
            IconSet.Gamepad
        } else {
            IconSet.Disc
        }
    }

    pure function status-icon(s: ComponentStatus) -> Icon {
        if s == ComponentStatus.Installed {
            IconSet.CircleCheck
        } else if s == ComponentStatus.Corrupted {
            IconSet.CircleX
        } else if s == ComponentStatus.Missing {
            IconSet.CircleAlert
        } else {
            IconSet.RefreshCw
        }
    }

    pure function status-color(s: ComponentStatus) -> brush {
        if s == ComponentStatus.Installed {
            #3fae5a
        } else if s == ComponentStatus.Uploading {
            MyPalette.foreground
        } else {
            MyPalette.destructive
        }
    }

    pure function status-text(s: ComponentStatus) -> string {
        if s == ComponentStatus.Installed {
            "Installed"
        } else if s == ComponentStatus.Corrupted {
            "Corrupted"
        } else if s == ComponentStatus.Missing {
            "Missing"
        } else {
            "Uploading"
        }
    }

    height: max(32px, layout.preferred-height);
    border-radius: 6px;
    // background: ta.has-hover ? MyPalette.alternate-background : transparent;

    // Under the trash button (declared later), so the button still gets its
    // clicks; only there to drive the row's hover state.
    ta := TouchArea { }

    layout := HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: CrossAxisAlignment.center;

        HorizontalLayout {
            width: col-kind;
            spacing: 5px;
            cross-axis-alignment: CrossAxisAlignment.center;

            IconDisplay {
                icon: kind-icon(comp.kind);
                stroke: MyPalette.foreground;
                size: 14px;
            }

            Text {
                text: comp.kind;
                vertical-alignment: center;
            }
        }

        Text {
            text: comp.description;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            text: comp.size-gib > 0 ? "\{comp.size-gib.to-fixed(2)} GiB" : "—";
            width: col-size;
            vertical-alignment: center;
        }

        // Status is icon-only to save space; the label shows as a tooltip.
        HorizontalLayout {
            width: col-status;
            alignment: start;
            cross-axis-alignment: CrossAxisAlignment.center;

            TooltipArea {
                width: 18px;
                height: 18px;
                tooltip: status-text(comp.status);

                IconDisplay {
                    icon: status-icon(comp.status);
                    stroke: status-color(comp.status);
                    size: 14px;
                }
            }
        }
    }

    // Overlaid at the right edge so it doesn't shift the columns; revealed
    // only while the row is hovered.
    del := IconButton {
        // A TouchArea-based element fills its parent by default when it isn't
        // inside a layout, so pin an explicit square size.
        width: 25px;
        height: 25px;
        x: parent.width - self.width - 10px /* scrollbar */;
        y: (parent.height - self.height) / 2;
        // Include the button's own hover so it stays visible once the pointer
        // moves onto it (which pulls hover off `ta`).
        visible: (ta.has-hover || del.has-hover) && deletable;
        icon: IconSet.Trash;
        kind: IconButtonKind.DestructiveText;
        disabled: UiState.conversion-queue.length > 0;
        tooltip: UiState.conversion-queue.length > 0 ? "Unavailable while the conversion queue is running" : "";
        clicked => {
            root.delete-requested();
        }
    }
}

export component GameInfoModal inherits Modal {
    max-w: 640px;
    min-w: 520px;
    min-h: 460px;
    max-h: 620px;

    // Shared column widths so the header and every row line up.
    property <length> col-kind: 72px;
    property <length> col-size: 84px;
    property <length> col-status: 64px;

    // Fill the whole card: the shared Modal body uses `alignment: start`,
    // which ignores stretch factors, so wrap our content in a layout pinned
    // to full height. Inside it the default `stretch` alignment lets the
    // table grow and keeps the footer at the bottom.
    VerticalLayout {
        height: 100%;

    // Header: title + core info on the left, cover tucked into the top-right
    // corner (rounded, with a drop shadow).
    HorizontalLayout {
        vertical-stretch: 0;
        padding: 20px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            alignment: start;

            Text {
                text: UiState.current-game.title;
                font-size: 22px;
                font-weight: 600;
                overflow: elide;
            }

            // Rule under the title, stopping short of the cover (its right
            // edge already sits one modal-padding away, thanks to the header
            // spacing).
            HorizontalLine { }

            VerticalLayout {
                spacing: 5px;
                alignment: start;

                HorizontalLayout {
                    spacing: 5px;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    IconDisplay {
                        icon: IconSet.Gamepad;
                        stroke: MyPalette.foreground;
                        size: 14px;
                    }

                    if UiState.current-game.is-x360: Text {
                        text: "System: Xbox 360";
                    }

                    if !UiState.current-game.is-x360: Text {
                        text: "System: Original Xbox";
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    IconDisplay {
                        icon: IconSet.HardDrive;
                        stroke: MyPalette.foreground;
                        size: 14px;
                    }

                    Text {
                        text: "Size: \{UiState.current-game.size-gib.to-fixed(2)} GiB";
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    IconDisplay {
                        icon: IconSet.Tag;
                        stroke: MyPalette.foreground;
                        size: 14px;
                    }

                    Text {
                        text: "Title ID: \{(UiState.current-game.id.is-empty ? "N/A" : UiState.current-game.id)}";
                    }
                }

                HorizontalLayout {
                    spacing: 5px;
                    cross-axis-alignment: CrossAxisAlignment.center;

                    IconDisplay {
                        icon: IconSet.FileQuestionMark;
                        stroke: MyPalette.foreground;
                        size: 14px;
                    }

                    Text {
                        text: "Format: \{UiState.current-game.format}";
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: start;

            // Shadow caster, sized exactly to the cover so the drop shadow
            // hugs it (a layout-stretched wrapper would shadow the wrong box).
            if UiState.current-game.cover.width > 0: Rectangle {
                width: cover.width;
                height: cover.height;
                background: black;
                border-radius: 8px;
                // No offset: an even halo all around, rather than a shadow
                // pushed to one side (which left a hard seam along the top).
                drop-shadow-blur: 14px;
                drop-shadow-color: #00000055;

                // Inner clip rounds the image corners.
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: 8px;
                    clip: true;

                    cover := CoverImage {
                        source: UiState.current-game.cover;
                        height: 190px;
                    }
                }
            }

            // No cover cached: neutral placeholder, same footprint as a
            // portrait front panel.
            if UiState.current-game.cover.width == 0: Rectangle {
                width: 142px;
                height: 190px;
                border-radius: 8px;
                background: MyPalette.alternate-background;

                IconDisplay {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon: IconSet.Image;
                    size: 48px;
                    stroke: MyPalette.foreground.transparentize(0.6);
                }
            }
        }
    }

    // Stored-components table: fills the remaining height and scrolls when
    // there are more rows than fit.
    VerticalLayout {
        vertical-stretch: 1;
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 10px;

            Text {
                text: "Content";
                width: col-kind;
                font-weight: 600;
                color: MyPalette.foreground.transparentize(0.35);
            }

            Text {
                text: "Description";
                horizontal-stretch: 1;
                font-weight: 600;
                color: MyPalette.foreground.transparentize(0.35);
            }

            Text {
                text: "Size";
                width: col-size;
                font-weight: 600;
                color: MyPalette.foreground.transparentize(0.35);
            }

            Text {
                text: "Status";
                width: col-status;
                font-weight: 600;
                color: MyPalette.foreground.transparentize(0.35);
            }
        }

        HorizontalLine { }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 6px;
                alignment: start;

                if UiState.fetching-game-details && UiState.current-game-components.length == 0: ProgressIndicator {
                    indeterminate: true;
                    height: 4px;
                }

                // Safety net only: every format now yields at least one row,
                // so an empty table means the listing itself failed.
                if !UiState.fetching-game-details && UiState.current-game-components.length == 0: Text {
                    text: "No content found";
                    color: MyPalette.foreground.transparentize(0.4);
                    horizontal-alignment: left;
                }

                for comp in UiState.current-game-components: ContentRow {
                    comp: comp;
                    col-kind: root.col-kind;
                    col-size: root.col-size;
                    col-status: root.col-status;
                    // Ask for confirmation without touching current-game, so
                    // the detail modal stays open beneath the confirmation.
                    delete-requested => {
                        UiState.content-to-delete = comp;
                    }
                }
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 0;

        HorizontalLine { }

        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                padding: 10px;

                IconButton {
                    label: "Delete game";
                    kind: IconButtonKind.DestructiveText;
                    disabled: UiState.conversion-queue.length > 0;
                    tooltip: UiState.conversion-queue.length > 0 ? "Unavailable while the conversion queue is running" : "";
                    clicked => {
                        // Open the delete-confirmation modal for this game and
                        // close the info modal so they don't stack.
                        UiState.game-to-delete = UiState.current-game;
                        UiState.current-game = { };
                        UiState.showing-title-updates = false;
                    }
                }
            }

            HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                // - TODO : Proper title update listing
                if false && UiState.current-game.is-x360 && !UiState.current-game.id.is-empty: IconButton {
                    label: "Title Updates";
                    icon: IconSet.Download;
                    kind: IconButtonKind.Secondary;
                    clicked => {
                        Dispatcher.dispatch(Message.FetchTitleUpdates, UiState.current-game.path);
                    }
                }

                IconButton {
                    label: "Close";
                    kind: IconButtonKind.Primary;
                    clicked => {
                        UiState.current-game = { };
                        UiState.showing-title-updates = false;
                    }
                }
            }
        }
    }
    }
}

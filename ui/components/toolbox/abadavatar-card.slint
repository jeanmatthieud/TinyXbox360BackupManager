import { IconSet } from "@lucide";
import { CheckBox, ComboBox, Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { IconButton } from "../icon-button.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";

// Card offering to build a homebrew boot USB key. Always shown, but the action
// is disabled while a target is connected (the key must be built standalone).
export component ABadAvatarCard inherits ToolboxCard {
    private property <bool> target-connected: !UiState.config.target.is-empty;

    // Nothing here is usable while the key is being built, while a target is
    // connected (the key must be prepared standalone)
    // — so veil the whole card rather than just its action row.
    disabled: UiState.creating-abadavatar || UiState.compat-busy || UiState.abadavatar-hdd-tool-busy || target-connected;
    disabled-tooltip: target-connected
        ? "Déconnectez d’abord la destination actuelle"
        : UiState.compat-busy
            ? "Attendez la fin de l’installation de la rétrocompatibilité Xbox originale."
            : UiState.abadavatar-hdd-tool-busy
                ? "Attendez la fin de l’écriture d’ABadAvatar sur le disque dur."
                : "";

    CardHeader {
        icon: IconSet.Usb;
        title: "Clé USB ABadAvatar";

        if UiState.creating-abadavatar: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }

    }

    HorizontalLine { }

    Text {
        text: "Crée une clé de démarrage homebrew (ABadAvatar + XeUnshackle + Aurora).\nBranchez d’abord une clé USB formatée en FAT32.";
        wrap: word-wrap;
    }

    // Version picker for the ABadAvatar boot chain. Where each version is
    // downloaded from is set in the Settings page. Expert only: the default
    // version is the one to use unless you know why not.
    if UiState.config.expert-mode: HorizontalLayout {
        spacing: 8px;

        VerticalLayout {
            alignment: center;

            Text {
                text: "Version d’ABadAvatar :";
            }
        }

        ComboBox {
            height: 34px;
            horizontal-stretch: 1;
            model: UiState.abadavatar.abadavatar-versions;
            // A ComboBox shows whatever `current-index` points at — assigning
            // `current-value` does NOT move the selection.
            current-index: UiState.abadavatar.abadavatar-version-index;
            selected => {
                Dispatcher.dispatch(Message.SetABadAvatarVersion, self.current-index);
            }
        }
    }

    CheckBox {
        text: "Télécharger et ajouter la mise à jour système officielle";
        checked: UiState.abadavatar.include-system-update;
        toggled => {
            Dispatcher.dispatch(Message.ToggleABadAvatarSystemUpdate, "");
        }
    }

    if UiState.config.expert-mode: CheckBox {
        text: "Démarrer Aurora sans délai (XeUnshackle Max)";
        checked: UiState.abadavatar.xeunshackle-autostart;
        toggled => {
            Dispatcher.dispatch(Message.ToggleABadAvatarAutostart, "");
        }
    }

    HorizontalLine { }

    CardActionRow {
        icon: IconSet.Hammer;
        text: !UiState.creating-abadavatar ? "Créer la clé USB ABadAvatar" : "En cours… consultez la barre d’état en bas.";
        // Opens the in-app removable-drive picker. Hidden escape hatch: a long
        // press falls back to the native folder picker (any arbitrary path).
        long-press-duration: 1500ms;
        clicked => Dispatcher.dispatch(Message.CreateABadAvatar, "");
        long-pressed => Dispatcher.dispatch(Message.PickABadAvatarMountPoint, "");
    }
}

import { Icon, IconDisplay, IconSet } from "@lucide";
import { MyPalette } from "../styling.slint";
import { IconButton } from "icon-button.slint";
import { JobKind } from "../types.slint";

// Icon standing for what a queued job does. Shared with the progress card so
// the running job keeps the same marker it had while pending.
export global JobIcon {
    public pure function icon(kind: JobKind) -> Icon {
        kind == JobKind.Add ? IconSet.ArrowUp
            : (kind == JobKind.Delete ? IconSet.Trash : IconSet.PackageMinus)
    }

    public pure function color(kind: JobKind) -> brush {
        kind == JobKind.Add ? MyPalette.foreground : MyPalette.destructive
    }
}

export component JobRow inherits Rectangle {
    in property <string> label;
    in property <JobKind> kind;
    // Reordering: the buttons are always shown so the rows stay aligned, and
    // are disabled at the ends of the list.
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    // Rounding of the cancel button's right corners: the first and last rows of
    // the list sit flush against the card's rounded corners.
    in property <length> radius-top-right: 0px;
    in property <length> radius-bottom-right: 0px;

    callback cancel();
    callback move-up();
    callback move-down();

    height: 28px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 2px;
        spacing: 6px;
        cross-axis-alignment: CrossAxisAlignment.center;

        IconDisplay {
            horizontal-stretch: 0;
            icon: JobIcon.icon(kind);
            stroke: JobIcon.color(kind);
            size: 14px;
        }

        Text {
            horizontal-stretch: 1;
            text: label;
            overflow: elide;
            vertical-alignment: center;
        }

        IconButton {
            horizontal-stretch: 0;
            icon: IconSet.ChevronUp;
            tooltip: "Move up in the queue";
            disabled: !can-move-up;
            height: 24px;
            width: 24px;
            squared: true;
            clicked => move-up();
        }

        IconButton {
            horizontal-stretch: 0;
            icon: IconSet.ChevronDown;
            tooltip: "Move down in the queue";
            disabled: !can-move-down;
            height: 24px;
            width: 24px;
            squared: true;
            clicked => move-down();
        }

        IconButton {
            horizontal-stretch: 0;
            icon: IconSet.X;
            tooltip: "Remove from the queue";
            height: 24px;
            width: 24px;
            squared: true;
            radius-top-right: root.radius-top-right;
            radius-bottom-right: root.radius-bottom-right;
            clicked => cancel();
        }
    }
}

import { MyPalette } from "../styling.slint";
import { Icon, IconDisplay, IconSet } from "@lucide";
import { HorizontalLine } from "horizontal-line.slint";
import { Card } from "card.slint";
import { TooltipArea } from "tooltip-area.slint";
import { UiState } from "../ui-state.slint";
import { Message, Dispatcher } from "../messages.slint";

export component SettingCard inherits Card {
    in property <string> label;
    in property <Icon> icon;
    in property <[{ value: string, label: string }]> items;
    in property <string> active-item;
    in property <Message> set-property;
    // Optional secondary line shown under the choices (e.g. flagging
    // experimental options); hidden when empty.
    in property <string> note;
    // Locks the choices behind the standard disabled veil, e.g. for a setting
    // the running conversion queue depends on. `disabled-tooltip` says why.
    in property <bool> disabled: false;
    in property <string> disabled-tooltip;

    callback changed();

    width: 100%;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 5px;
            cross-axis-alignment: CrossAxisAlignment.center;

            IconDisplay {
                icon: icon;
                stroke: MyPalette.foreground;
                size: 14px;
            }

            Text {
                text: label;
            }
        }

        HorizontalLine { }

        for item in items: Rectangle {
            HorizontalLayout {
                spacing: 5px;
                cross-axis-alignment: CrossAxisAlignment.center;

                IconDisplay {
                    icon: item.value == active-item ? IconSet.Disc : IconSet.Circle;
                    stroke: item.value == active-item ? MyPalette.accent-background : MyPalette.foreground;
                    size: 14px;
                }

                Text {
                    text: item.label;
                }
            }

            TouchArea {
                clicked => {
                    if item.value != active-item {
                        Dispatcher.dispatch(set-property, item.value);
                        changed();
                    }
                }
            }
        }

        if note != "": Text {
            text: note;
            wrap: word-wrap;
            font-size: 11px;
            color: MyPalette.foreground.transparentize(0.4);
        }
    }

    // Declared last so it covers the whole card and swallows every click.
    if disabled: TooltipArea {
        disabled: true;
        tooltip: disabled-tooltip;
        veil-border-radius: root.border-radius;
    }
}

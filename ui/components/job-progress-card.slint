import { IconDisplay, IconSet } from "@lucide";
import { MyPalette } from "../styling.slint";
import { UiState } from "../ui-state.slint";
import { JobKind } from "../types.slint";
import { Card } from "card.slint";
import { IconButton } from "icon-button.slint";
import { JobIcon } from "job-row.slint";
import { ProgressBar } from "progress-bar.slint";

// The job currently running (index 0 of the queue), shown as a card of its
// own: it is not listed among the pending items, which are reorderable.
export component JobProgressCard inherits Card {
    // Secondary line: the step the percentage refers to, plus the measured
    // speed when there is one (only the FTP upload measures a speed).
    pure function details() -> string {
        if !UiState.job-phase.is-empty && !UiState.job-speed.is-empty {
            UiState.job-phase + "  ·  " + UiState.job-speed
        } else if !UiState.job-phase.is-empty {
            UiState.job-phase
        } else {
            UiState.job-speed
        }
    }

    height: v.preferred-height;

    v := VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: CrossAxisAlignment.center;

            IconDisplay {
                horizontal-stretch: 0;
                icon: JobIcon.icon(UiState.job-kind);
                stroke: JobIcon.color(UiState.job-kind);
                size: 14px;
            }

            Text {
                horizontal-stretch: 1;
                text: UiState.job-label;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            // Stops this job only: the pending items stay queued and the next
            // one starts right after.
            IconButton {
                horizontal-stretch: 0;
                icon: IconSet.X;
                tooltip: UiState.cancelling-current
                    ? "Cancellation already requested"
                    : (UiState.job-kind == JobKind.Add
                        ? "Cancel this conversion"
                        : "Cancel this deletion");
                disabled: UiState.cancelling-current || UiState.cancelling-queue;
                height: 24px;
                width: 24px;
                squared: true;
                clicked => {
                    UiState.confirming-cancel-current = true;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: CrossAxisAlignment.center;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;

                ProgressBar {
                    progress: UiState.job-progress;
                    fill: UiState.cancelling-current || UiState.cancelling-queue
                        ? MyPalette.destructive
                        : MyPalette.accent-background;
                }
            }

            Text {
                horizontal-stretch: 0;
                min-width: 40px;
                text: Math.round(UiState.job-progress * 100) + " %";
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        if UiState.cancelling-current || !details().is-empty: Text {
            // While cancelling, the phase line still wins when there is one:
            // the cleanup pushed by the core (deleting thousands of extracted
            // files) is exactly what has to stay visible here.
            text: UiState.cancelling-current && details().is-empty
                ? (UiState.job-kind == JobKind.Add
                    ? "Cancelling this conversion..."
                    : "Cancelling this deletion...")
                : details();
            color: UiState.cancelling-current
                ? MyPalette.destructive
                : MyPalette.foreground.transparentize(0.4);
            font-size: 12px;
            overflow: elide;
        }
    }
}

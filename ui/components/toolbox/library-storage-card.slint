import { IconSet, IconDisplay, Icon } from "@lucide";
import { Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { IconButton } from "../icon-button.slint";
import { MyPalette } from "../../styling.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";
import { GodLayout, TargetKind } from "../../types.slint";

// An icon beside a title, with whatever lines follow the title below it. The
// icon centres on the title's line rather than on the whole block.
component IconRow inherits HorizontalLayout {
    in property <Icon> icon;
    in property <brush> stroke: MyPalette.foreground;
    in property <string> title;

    spacing: 8px;
    cross-axis-alignment: CrossAxisAlignment.start;

    // A fixed-size child is centred in its parent by default.
    Rectangle {
        width: 15px;
        height: title-text.preferred-height;

        IconDisplay {
            icon: root.icon;
            stroke: root.stroke;
            size: 15px;
        }
    }

    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;

        title-text := Text {
            text: root.title;
        }

        @children
    }
}

// App storage folders (and, on a console, their Aurora scan coverage).
export component LibraryStorageCard inherits ToolboxCard {
    function god-layout-label(v: GodLayout) -> string {
        return v == GodLayout.NameSlashTitleId ? "Nom / TitleID" :
            v == GodLayout.NameDashTitleId ? "Nom - TitleID / TitleID" :
            v == GodLayout.TitleIdDashName ? "TitleID - Nom / TitleID" :
            "TitleID";
    }

    CardHeader {
        icon: IconSet.FolderCog;
        title: "Stockage de la bibliothèque";

        if UiState.fetching-aurora-paths: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }

        // Console-shaped targets (FTP and FATX alike), as in the scan-paths
        // card next to it.
        if UiState.config.target-kind != TargetKind.Local && !UiState.fetching-aurora-paths: IconButton {
            icon: IconSet.RefreshCcw;
            width: self.height;
            clicked => {
                if !UiState.fetching-aurora-paths {
                    Dispatcher.dispatch(Message.FetchAuroraPaths, "");
                }
            }
        }
    }

    HorizontalLine { }

    Text {
        text: "Dossiers utilisés pour installer et rechercher vos jeux.";
        font-size: 12px;
        wrap: word-wrap;
        color: MyPalette.foreground.transparentize(0.4);
    }

    if UiState.fetching-aurora-paths && !UiState.aurora-paths-loaded: Text {
        text: "Lecture de la configuration du stockage…";
    }

    if UiState.app-storage-paths.length > 0: VerticalLayout {
        spacing: 10px;

        for p in UiState.app-storage-paths: IconRow {
            // Neutral folder on a local drive (no Aurora comparison);
            // coverage badge on a console.
            icon: !UiState.storage-aurora-compared
                ? IconSet.Folder
                : (p.covered ? IconSet.Check : IconSet.TriangleAlert);
            stroke: !UiState.storage-aurora-compared
                ? MyPalette.foreground
                : (p.covered ? MyPalette.foreground : #e0a12f);
            title: p.label;

            Text {
                text: p.aurora-path;
                font-size: 12px;
                wrap: char-wrap;
                color: MyPalette.foreground.transparentize(0.4);
            }

            if UiState.storage-aurora-compared && !p.covered: Text {
                text: "Pas encore analysé par Aurora.";
                font-size: 11px;
                color: #e0a12f;
            }
        }

        IconRow {
            icon: IconSet.FolderTree;
            title: "Organisation du stockage GOD";

            Text {
                text: god-layout-label(UiState.storage-god-layout);
                font-size: 12px;
                wrap: char-wrap;
                color: MyPalette.foreground.transparentize(0.4);
            }
        }
    }

    // At least one folder isn't covered: guide the user.
    if UiState.storage-has-uncovered: VerticalLayout {
        spacing: 8px;
        height: self.preferred-height;

        HorizontalLine { }

        Text {
            text: "Ajoutez les dossiers indiqués dans Aurora (Settings > Content Paths, profondeur 3 ou plus) pour afficher les jeux sur la console, puis relancez l’analyse.";
            wrap: word-wrap;
            color: #e0a12f;
        }

        HorizontalLine { }

        CardActionRow {
            icon: IconSet.CircleQuestionMark;
            text: "Aide pour ajouter les chemins dans Aurora";
            clicked => { UiState.showing-aurora-help = true };
        }
    }

    if !UiState.storage-has-uncovered: HorizontalLine { }

    CardActionRow {
        icon: IconSet.FolderCog;
        text: "Modifier les dossiers de stockage";
        disabled: UiState.fetching-aurora-paths;
        clicked => Dispatcher.dispatch(Message.EditStorageConfig, "");
    }
}

import { Palette } from "std-widgets.slint";
import { Navbar } from "components/navbar.slint";
import { GameGridPage } from "game-grid-page.slint";
import { SettingsPage } from "settings-page.slint";
import { AboutPage } from "about-page.slint";
import { Page, DisplayedGame, JobKind, PendingQueueAction } from "types.slint";
import { Message, Dispatcher } from "messages.slint";
import { MyPalette } from "styling.slint";
import { VerticalLine } from "components/vertical-line.slint";
import { Card } from "components/card.slint";
import { IconButton } from "components/icon-button.slint";
import { IconSet } from "@lucide";
import { GameTablePage } from "game-table-page.slint";
import { Notifications } from "components/notifications.slint";
import { GameInfoModal } from "components/game-info-modal.slint";
import { TitleUpdatesModal } from "components/title-updates-modal.slint";
import { ConfirmationModal } from "components/confirmation-modal.slint";
import { ABadAvatarHddTargetModal } from "components/abadavatar-hdd-target-modal.slint";
import { Tooltip } from "tooltip.slint";
import { ToolboxPage } from "toolbox-page.slint";
import { DeviceStatusPage } from "device-status-page.slint";
import { JobQueuePage } from "job-queue.slint";
import { SelectTargetModal } from "components/select-target-modal.slint";
import { ABadAvatarTargetModal } from "components/abadavatar-target-modal.slint";
import { CompatTargetModal } from "components/compat-target-modal.slint";
import { FtpTargetModal } from "components/ftp-target-modal.slint";
import { AuroraHelpModal } from "components/aurora-help-modal.slint";
import { StorageConfigModal } from "components/storage-config-modal.slint";
import { ConfettiBurst } from "components/confetti.slint";
import { UiState } from "ui-state.slint";

export * from "types.slint";
export { UiState, Message, Dispatcher }

export component AppWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    background: MyPalette.background;
    title: UiState.drive-info.label.is-empty ? "TinyXbox360BackupManager FR  ›  Aucune destination sélectionnée" : (UiState.drive-info.total-gib > 0 ? "TinyXbox360BackupManager FR  ›  \{UiState.drive-info.label}  (\{UiState.drive-info.used-gib.to-fixed(2)}/\{UiState.drive-info.total-gib.to-fixed(2)} Gio)" : "TinyXbox360BackupManager FR  ›  \{UiState.drive-info.label}");
    icon: @image-url("../package/windows/TinyXbox360BackupManager-64x64.png");
    default-font-size: 14px;

    // Initialize
    Timer {
        interval: 100ms;
        running: true;

        triggered => {
            if UiState.config.theme-preference == "Light" {
                Palette.color-scheme = ColorScheme.light;
            } else if UiState.config.theme-preference == "Dark" {
                Palette.color-scheme = ColorScheme.dark;
            }
            if Palette.color-scheme == ColorScheme.dark {
                Dispatcher.dispatch(Message.SetWindowColorDark, "");
            } else {
                Dispatcher.dispatch(Message.SetWindowColorLight, "");
            }

            Dispatcher.dispatch(Message.CheckForUpdates, "");
            Dispatcher.dispatch(Message.CheckMountPoint, "");

            self.running = false;
        }
    }

    HorizontalLayout {
        Navbar { }

        VerticalLayout {
            Rectangle {
                background: MyPalette.alternate-background;
                border-top-left-radius: 10px;

                if UiState.current-page == Page.Games && UiState.config.view-as == "Grid": GameGridPage { }
                if UiState.current-page == Page.Games && UiState.config.view-as == "Table": GameTablePage { }
                if UiState.current-page == Page.Toolbox: ToolboxPage { }
                if UiState.current-page == Page.DeviceStatus: DeviceStatusPage { }
                if UiState.current-page == Page.Jobs: JobQueuePage { }
                if UiState.current-page == Page.Settings: SettingsPage { }
                if UiState.current-page == Page.About: AboutPage { }

                // The frame is drawn here, after the pages, rather than as the
                // border of the rectangle above: a rectangle paints its border
                // beneath its children, so a scrolled page whose cards reach
                // the bottom edge used to hide the line over the status bar.
                // No TouchArea: clicks go straight through to the page.
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-top-left-radius: 10px;
                    border-width: 1px;
                    border-color: MyPalette.border;
                }
            }

            if !UiState.status.is-empty: HorizontalLayout {
                VerticalLine { }

                HorizontalLayout {
                    alignment: space-between;
                    padding: 10px;

                    Text {
                        vertical-alignment: center;
                        text: UiState.status;
                    }

                    if UiState.scanning: IconButton {
                        icon: IconSet.X;
                        tooltip: "Annuler l’analyse";
                        height: 24px;
                        width: 24px;
                        squared: true;
                        clicked => Dispatcher.dispatch(Message.CancelScan, "");
                    }

                    if UiState.creating-abadavatar: IconButton {
                        icon: IconSet.X;
                        tooltip: "Annuler la création de la clé ABadAvatar";
                        height: 24px;
                        width: 24px;
                        squared: true;
                        clicked => Dispatcher.dispatch(Message.CancelABadAvatar, "");
                    }

                    if UiState.abadavatar-hdd-busy && !UiState.abadavatar-hdd-writing: IconButton {
                        icon: IconSet.X;
                        tooltip: "Annuler l’installation d’ABadAvatar";
                        height: 24px;
                        width: 24px;
                        squared: true;
                        clicked => Dispatcher.dispatch(Message.CancelABadAvatarHdd, "");
                    }

                    if UiState.installing-compat: IconButton {
                        icon: IconSet.X;
                        tooltip: "Annuler l’installation de la rétrocompatibilité";
                        height: 24px;
                        width: 24px;
                        squared: true;
                        clicked => Dispatcher.dispatch(Message.CancelCompat, "");
                    }
                }
            }
        }
    }

    if !UiState.current-game.path.is-empty: GameInfoModal { }

    // Confirm deleting a single stored component. Stacked above the info modal
    // (current-game stays set), so that modal remains open underneath.
    if UiState.content-to-delete.id != "": ConfirmationModal {
        Text {
            text: "Supprimer \{UiState.content-to-delete.description} (\{UiState.content-to-delete.kind}) ?\nCe contenu sera retiré du jeu. Cette action est irréversible."
                + (UiState.job-queue.length > 0
                    ? "\nLa file est occupée : la suppression commencera après les tâches précédentes."
                    : "");
            wrap: word-wrap;
        }
        destructive: true;
        cancelled => {
            UiState.content-to-delete = { };
        }
        confirmed => {
            Dispatcher.dispatch(Message.DeleteContent, "\{UiState.current-game.path}\n\{UiState.content-to-delete.kind}\n\{UiState.content-to-delete.id}\n\{UiState.content-to-delete.description}");
            UiState.content-to-delete = { };
        }
    }
    if UiState.showing-title-updates: TitleUpdatesModal { }

    if UiState.selecting-target: SelectTargetModal { }
    if UiState.selecting-abadavatar-target: ABadAvatarTargetModal { }
    if UiState.selecting-compat-target: CompatTargetModal { }
    if UiState.selecting-abadavatar-hdd-target: ABadAvatarHddTargetModal { }
    if UiState.editing-ftp-target: FtpTargetModal { }
    if UiState.showing-aurora-help: AuroraHelpModal { }
    if UiState.configuring-storage: StorageConfigModal { }

    if !UiState.game-to-delete.path.is-empty: ConfirmationModal {
        Text {
            text: "Voulez-vous vraiment supprimer \{UiState.game-to-delete.title} ?\nCette action est irréversible."
                + (UiState.job-queue.length > 0
                    ? "\nLa file est occupée : la suppression commencera après les tâches précédentes."
                    : "");
            wrap: word-wrap;
        }
        destructive: true;
        cancelled => {
            UiState.game-to-delete = { };
        }
        confirmed => {
            Dispatcher.dispatch(Message.DeleteGame, UiState.game-to-delete.path);
            UiState.game-to-delete = { };
        }
    }

    if UiState.games-to-add.length > 0: ConfirmationModal {
        Text {
            text: "Ajouter \{UiState.games-to-add.length} conversions à la file d’attente ?";
        }

        // An entry whose TitleID is already installed on the target is called
        // out here rather than failing later: the conversion overwrites it.
        if UiState.games-to-add-conflicts > 0: Text {
            text: UiState.games-to-add-conflicts == 1
                ? "Un jeu est déjà installé à cette destination et sera remplacé."
                : "\{UiState.games-to-add-conflicts} jeux sont déjà installés à cette destination et seront remplacés.";
            color: MyPalette.warning;
            wrap: word-wrap;
        }

        for entry in UiState.games-to-add: VerticalLayout {
            Text {
                text: "• \{entry.name}";
                overflow: elide;
            }

            if entry.already-installed: Text {
                text: "    ↻ remplace \"\{entry.installed-title}\"";
                color: MyPalette.warning;
                overflow: elide;
            }
        }

        cancelled => Dispatcher.dispatch(Message.ClearGamesToAdd, "");
        confirmed => Dispatcher.dispatch(Message.ConfirmGamesToAdd, "");
    }

    if UiState.abadavatar-pending-path != "": ConfirmationModal {
        Text {
            text: "Créer la clé USB ABadAvatar dans \{UiState.abadavatar-pending-path} ?\nLe contenu déjà présent à cet emplacement pourra être remplacé.";
            wrap: word-wrap;
        }
        btn-icon: IconSet.Hammer;
        cancelled => Dispatcher.dispatch(Message.CancelCreateABadAvatar, "");
        confirmed => Dispatcher.dispatch(Message.ConfirmCreateABadAvatar, "");
    }

    if UiState.compat-pending-target != "": ConfirmationModal {
        Text {
            text: UiState.compat-formatting
                ? (UiState.compat-creating
                    ? "Créer la partition de rétrocompatibilité"
                    : "Formater la partition de rétrocompatibilité")
                : UiState.compat-restoring
                    ? "Restaurer une sauvegarde"
                    : "Installer le pack de rétrocompatibilité Xbox originale";
            font-size: 18px;
        }

        Rectangle { height: 5px; } // Spacing

        if !UiState.compat-formatting: Text {
            text: (UiState.compat-restoring ? "Sauvegarde sélectionnée : " : "Pack sélectionné : ")
                + UiState.compat-pending-source;
            wrap: word-wrap;
        }

        if UiState.compat-creating: Text {
            text: "Ce disque n’a pas de partition de rétrocompatibilité. Elle sera créée dans l’espace réservé par la console, avant la partition des jeux. La partition des jeux sera conservée.";
            wrap: word-wrap;
        }

        Text {
            text: "Destination : \{UiState.compat-pending-target}";
            wrap: word-wrap;
        }

        // Empty when the partition is bare: there is then nothing to lose, and
        // no reason to colour the modal red over it.
        if UiState.compat-pending-summary != "": Text {
            text: UiState.compat-pending-summary;
            color: MyPalette.warning;
            wrap: word-wrap;
        }

        destructive: UiState.compat-pending-summary != "";
        btn-icon: IconSet.Hammer;
        confirm-label: "Confirmer";
        cancelled => Dispatcher.dispatch(Message.CancelInstallCompat, "");
        confirmed => Dispatcher.dispatch(Message.ConfirmInstallCompat, "");
    }

    if UiState.abadavatar-hdd-pending-target != "": ConfirmationModal {
        Text {
            text: "Installer ABadAvatar sur le disque dur";
            font-size: 18px;
        }

        Rectangle { height: 5px; } // Spacing

        Text {
            text: "La console doit utiliser le dashboard 2.0.17559.0 (Paramètres › Système › Infos console), avec les données d’avatar de cette mise à jour. Vérifiez-le avant de continuer : l’exploit fonctionne uniquement avec cette version.";
            color: MyPalette.warning;
            wrap: word-wrap;
        }

        Text {
            text: "Installation dans \{UiState.abadavatar-hdd-pending-target} : ABadAvatar 1.3-beta, XeUnshackle"
                + ", le fichier launch.ini de Dashlaunch et ses plugins"
                + (UiState.abadavatar-hdd-pending-aurora != ""
                    ? ", avec lancement d’Aurora déjà présent dans \{UiState.abadavatar-hdd-pending-aurora}."
                    : ", et Aurora, installé dans Hdd:\\Aurora.");
            wrap: word-wrap;
        }

        Text {
            text: "Avant de démarrer la console : déconnectez-la d’Internet, désactivez la connexion automatique au profil et retirez toute clé USB ABadAvatar (la console la recherche en priorité).";
            wrap: word-wrap;
        }

        btn-icon: IconSet.Hammer;
        confirm-label: "Installer";
        cancelled => Dispatcher.dispatch(Message.CancelInstallABadAvatarHdd, "");
        confirmed => Dispatcher.dispatch(Message.ConfirmInstallABadAvatarHdd, "");
    }

    if UiState.confirming-abadavatar-hdd-uninstall: ConfirmationModal {
        Text {
            text: "Retirer ABadAvatar du disque dur";
            font-size: 18px;
        }

        Rectangle { height: 5px; } // Spacing

        Text {
            text: "Tous les fichiers fournis avec ABadAvatar seront supprimés de \{UiState.config.target}, pour rétablir le démarrage d’origine de la console :";
            wrap: word-wrap;
        }

        for item in UiState.abadavatar-hdd.removal: Text {
            text: "  • " + item;
            wrap: word-wrap;
        }

        Text {
            text: "Vos jeux seront conservés.";
            wrap: word-wrap;
            color: MyPalette.foreground.transparentize(0.35);
        }

        destructive: true;
        btn-icon: IconSet.Trash2;
        confirm-label: "Retirer";
        cancelled => {
            UiState.confirming-abadavatar-hdd-uninstall = false;
        }
        confirmed => {
            UiState.confirming-abadavatar-hdd-uninstall = false;
            Dispatcher.dispatch(Message.ConfirmUninstallABadAvatarHdd, "");
        }
    }

    if UiState.confirming-cancel-all: ConfirmationModal {
        Text {
            text: UiState.job-running
                ? "Annuler toutes les tâches ?\nLa tâche en cours sera arrêtée : les fichiers partiels d’une conversion sont nettoyés si possible ; une suppression laisse le jeu partiellement supprimé. Les fichiers déjà écrits sur la destination sont conservés."
                : "Annuler toutes les tâches en attente ?";
            wrap: word-wrap;
        }
        destructive: true;
        btn-icon: IconSet.X;
        cancelled => {
            UiState.confirming-cancel-all = false;
        }
        confirmed => {
            Dispatcher.dispatch(Message.CancelAllJobs, "");
            UiState.confirming-cancel-all = false;
        }
    }

    if UiState.confirming-cancel-current: ConfirmationModal {
        Text {
            text: UiState.job-kind == JobKind.Add
                ? "Annuler la conversion de \{UiState.job-label} ?\nLes fichiers partiels sont nettoyés si possible, mais les fichiers déjà écrits sur la destination sont conservés. Les autres tâches sont conservées et la suivante démarre immédiatement."
                : UiState.job-kind == JobKind.AuroraImport
                ? "Annuler la préparation des ressources Aurora ?\nLes jeux déjà préparés restent prêts à importer ; les autres sont ignorés. Les autres tâches sont conservées et la suivante démarre immédiatement."
                : "Annuler la suppression de \{UiState.job-label} ?\nLes fichiers supprimés ne seront pas restaurés : le jeu restera partiellement supprimé. Relancez sa suppression pour la terminer. Les autres tâches sont conservées et la suivante démarre immédiatement.";
            wrap: word-wrap;
        }
        destructive: true;
        btn-icon: IconSet.X;
        cancelled => {
            UiState.confirming-cancel-current = false;
        }
        confirmed => {
            Dispatcher.dispatch(Message.CancelJob, "0");
            UiState.confirming-cancel-current = false;
        }
    }

    if UiState.confirming-clear-aurora-import: ConfirmationModal {
        Text {
            text: "Supprimer les ressources Aurora à importer ?\nLe dossier d’importation d’Aurora sera vidé. Les ressources déjà importées dans Aurora seront conservées.";
            wrap: word-wrap;
        }
        destructive: true;
        btn-icon: IconSet.Trash;
        cancelled => {
            UiState.confirming-clear-aurora-import = false;
        }
        confirmed => {
            Dispatcher.dispatch(Message.ClearAuroraImport, "");
            UiState.confirming-clear-aurora-import = false;
        }
    }

    // Disconnect / quit asked for while the queue is still busy: the action is
    // only carried out once the queue has been cancelled and drained.
    if UiState.pending-queue-action != PendingQueueAction.None && !UiState.draining-queue: ConfirmationModal {
        Text {
            text: (UiState.pending-queue-action == PendingQueueAction.Quit
                ? "Des tâches sont encore en attente.\nAnnuler la file et quitter ?"
                : "Des tâches sont encore en attente.\nAnnuler la file et déconnecter ?")
                + (UiState.job-running
                    ? "\nLa tâche en cours sera arrêtée. Les fichiers déjà écrits ou supprimés sur la destination resteront en l’état."
                    : "");
            wrap: word-wrap;
        }
        destructive: true;
        btn-icon: IconSet.X;
        cancelled => Dispatcher.dispatch(Message.AbortQueueAction, "");
        confirmed => Dispatcher.dispatch(Message.ConfirmCancelQueueAction, "");
    }

    // Whole batch done. Sits below the notifications so the
    // "queue empty" toast stays readable, and above everything else. Purely
    // decorative: no TouchArea, so clicks go straight through it.
    if UiState.celebrating: ConfettiBurst {
        width: root.width;
        height: root.height;
        finished => {
            UiState.celebrating = false;
        }
    }

    if UiState.notifications.length > 0: Notifications {
        x: root.width - self.width;
        y: root.height - self.height;
    }

    if !Tooltip.text.is-empty: Card {
        x: Tooltip.mouse-x + t.preferred-width + 18px > root.width ? Tooltip.mouse-x - t.preferred-width - 18px : Tooltip.mouse-x;
        y: Tooltip.mouse-y;

        width: t.preferred-width + 18px;
        height: t.preferred-height + 16px;

        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 9px;
            padding-right: 9px;

            t := Text {
                text: Tooltip.text;
            }
        }
    }
}

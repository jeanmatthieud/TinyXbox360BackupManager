import { IconSet } from "@lucide";
import { Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { WarningNote } from "../warning-note.slint";
import { MyPalette } from "../../styling.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";

// Installs ABadAvatar on a console's internal hard drive connected to this
// computer, so the exploit boots with no USB key. Like the USB key, it is a
// standalone tool: always shown, so users know it exists, but only usable with
// no target connected — it picks its drive itself. The state of a connected
// drive, and the removal, live in the Device status page.
export component ABadAvatarHddInstallCard inherits ToolboxCard {
    private property <bool> target-connected: !UiState.config.target.is-empty;

    // Excludes the other Toolbox tools, as they exclude each other: they share
    // the status line and its cancel button.
    disabled: UiState.abadavatar-hdd-tool-busy || UiState.creating-abadavatar || UiState.compat-busy || target-connected;
    disabled-tooltip: target-connected
        ? "Déconnectez d’abord la destination actuelle"
        : UiState.creating-abadavatar
            ? "Attendez la fin de l’écriture de la clé USB ABadAvatar."
            : UiState.compat-busy
                ? "Attendez la fin de l’installation de la rétrocompatibilité Xbox originale."
                : "";

    CardHeader {
        icon: IconSet.HardDrive;
        title: "ABadAvatar sur un disque dur de console";

        if UiState.abadavatar-hdd-tool-busy: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }
    }

    HorizontalLine { }

    Text {
        text: "Installe ABadAvatar sur le disque dur interne de la console, branché à cet ordinateur, pour démarrer l’exploit sans clé USB.";
        wrap: word-wrap;
    }

    Text {
        text: "ABadAvatar 1.3-beta, XeUnshackle et un launch.ini démarrant Aurora — ainsi qu’Aurora si le disque n’en contient pas.";
        font-size: 12px;
        wrap: word-wrap;
        color: MyPalette.foreground.transparentize(0.35);
    }

    WarningNote {
        text: "Vérifiez la console : Paramètres › Système › Infos console doit indiquer le dashboard 2.0.17559.0. L’exploit fonctionne uniquement avec cette version.";
    }

    HorizontalLine { }

    CardActionRow {
        icon: IconSet.Hammer;
        text: !UiState.abadavatar-hdd-tool-busy ? "Installer ABadAvatar sur un disque dur interne de console" : "En cours… consultez la barre d’état en bas.";
        clicked => Dispatcher.dispatch(Message.InstallABadAvatarHdd, "");
    }
}

import { IconSet } from "@lucide";
import { CheckBox, ComboBox, Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { IconButton } from "../icon-button.slint";
import { WarningNote } from "../warning-note.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";

// Expert body of the card: any pack, including the user's own, and every
// option left to the user.
component CompatExpertBody inherits VerticalLayout {
    spacing: 10px;

    // WarningNote {
    //     text: "Experimental: replaces the partition required to boot original Xbox games.";
    // }

    picker := HorizontalLayout {
        spacing: 8px;

        pack-label := VerticalLayout {
            alignment: center;

            Text {
                text: "Emulator pack:";
            }
        }

        ComboBox {
            height: 34px;
            horizontal-stretch: 1;
            model: UiState.compat.packs;
            // A ComboBox shows whatever `current-index` points at — assigning
            // `current-value` does NOT move the selection.
            current-index: UiState.compat.pack-index;
            selected => {
                Dispatcher.dispatch(Message.SetCompatPack, self.current-index);
            }
        }
    }

    // Indented to the drop-down's own left edge rather than the card's, so it
    // reads as a caption of the selection above instead of as a new paragraph.
    HorizontalLayout {
        padding-left: pack-label.width + picker.spacing;

        Text {
            text: UiState.compat.pack-description;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    // Indented like the description above it: both belong to the drop-down,
    // unlike the card-level warning higher up.
    if UiState.compat.needs-exploit: HorizontalLayout {
        padding-left: pack-label.width + picker.spacing;

        WarningNote {
            text: "Requires Aurora + BadUpdate/BadAvatar/RGH to run.";
        }
    }

    CheckBox {
        text: "Backup the current compatibility files first (zip file)";
        checked: UiState.compat.backup-first;
        toggled => {
            Dispatcher.dispatch(Message.ToggleCompatBackup, "");
        }
    }

    CheckBox {
        text: "Update the per-title configs to support more games";
        checked: UiState.compat.update-configs;
        toggled => {
            Dispatcher.dispatch(Message.ToggleCompatConfigs, "");
        }
    }

    // Caption of the checkbox above, indented to its label like the pack
    // description is to the drop-down.
    if UiState.compat.update-configs: HorizontalLayout {
        padding-left: 24px;

        Text {
            text: "Community configs from " + UiState.compat.configs-source + ", written to Compatibility/Configs.";
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    HorizontalLine { }

    CardActionRow {
        icon: IconSet.Hammer;
        text: !UiState.installing-compat
            ? "Install the compatibility files"
            : "Working… see the status bar below.";
        clicked => Dispatcher.dispatch(Message.InstallCompat, "");
    }

    // Hard drive only: lays a blank filesystem over the partition, or creates
    // it on a drive that has none. Asks which once the drive is picked.
    if !UiState.installing-compat: CardActionRow {
        icon: IconSet.HardDrive;
        text: "Create / format the compatibility partition (🧪 boldly experimental)";
        clicked => Dispatcher.dispatch(Message.FormatCompat, "");
    }
}

// Simple body of the card (expert mode off): the two packs a non-expert needs,
// one button each. The backup is always made, and the per-title configs always
// come with the patch: both are forced on the Rust side
// (`State::compat_run_config`), never written to the saved settings.
component CompatSimpleBody inherits VerticalLayout {
    spacing: 10px;

    Text {
        text: "The current files are saved to a zip file first: you pick where before anything is written.";
        font-size: 12px;
        wrap: word-wrap;
    }

    HorizontalLine { }

    CardActionRow {
        icon: IconSet.Undo2;
        text: "Restore retail (as a factory drive carries it)";
        clicked => Dispatcher.dispatch(Message.InstallCompat, "retail");
    }

    CardActionRow {
        icon: IconSet.Hammer;
        text: "Apply patch (no whitelist, with HUD)";
        clicked => Dispatcher.dispatch(Message.InstallCompat, "hacked_hud");
    }

    WarningNote {
        text: "The patch requires Aurora + BadUpdate/BadAvatar/RGH to run.";
    }
}

// Card offering to write the original-Xbox emulator onto a console's
// compatibility partition. Like the BadAvatar card it is a standalone tool: it
// picks its own console (over the network, or its hard drive on this computer)
// and is therefore unusable while a target is connected — which is also what
// keeps it clear of the job queue's single-writer rule.
export component OgXboxCompatCard inherits ToolboxCard {
    private property <bool> target-connected: !UiState.config.target.is-empty;

    // The two Toolbox tools exclude each other: they share the status line and
    // the toolbar's cancel button, so running both at once makes progress and
    // cancellation unreadable.
    disabled: UiState.compat-busy || UiState.creating-badavatar || UiState.badavatar-hdd-tool-busy || target-connected;
    disabled-tooltip: target-connected
        ? "Disconnect from the current target first"
        : UiState.creating-badavatar
            ? "Wait for the BadAvatar USB key to be written."
            : UiState.badavatar-hdd-tool-busy
                ? "Wait for BadAvatar to be written to the hard drive."
                : "";

    CardHeader {
        icon: IconSet.Gamepad2;
        title: "Original Xbox compatibility";

        if UiState.installing-compat: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }

        // Puts a backup this tool wrote earlier back on a console, instead of
        // one of the published packs.
        if !UiState.installing-compat: IconButton {
            icon: IconSet.Upload;
            width: self.height;
            tooltip: "Restore a compatibility backup (.zip)";
            clicked => Dispatcher.dispatch(Message.RestoreCompat, "");
        }
    }

    HorizontalLine { }

    Text {
        text: "Installs Xbox emulator files to HddX to expand original Xbox game compatibility.";
        wrap: word-wrap;
    }

    if UiState.config.expert-mode: CompatExpertBody { }

    if !UiState.config.expert-mode: CompatSimpleBody { }
}

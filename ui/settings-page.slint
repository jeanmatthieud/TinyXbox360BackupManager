import { ScrollView, Palette, ComboBox } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { SettingCard } from "components/setting-card.slint";
import { PageHeader } from "components/page-header.slint";
import { CoversCacheCard } from "components/toolbox/covers-cache-card.slint";
import { DownloadSourcesCard } from "components/download-sources-card.slint";
import { UiState } from "ui-state.slint";
import { Message, Dispatcher } from "messages.slint";

export component SettingsPage inherits VerticalLayout {
    PageHeader {
        title: "Paramètres";
    }

    ScrollView {
        VerticalLayout {
            width: 100%;
            padding: 10px;
            padding-top: 0px;
            spacing: 10px;
            alignment: start;

            if UiState.config.expert-mode-switchable: SettingCard {
                icon: IconSet.FlaskConical;
                label: "Mode expert";
                items: [
                    { value: "false", label: "Désactivé" },
                    { value: "true", label: "Activé" }
                ];
                active-item: UiState.config.expert-mode ? "true" : "false";
                set-property: Message.SetExpertMode;
                note: "Affiche les outils avancés : accès au disque dur de la console, mises à jour des jeux, options Dashlaunch, sources de téléchargement…";
                // Turning it off would hide the card of a tool still at work,
                // its status line and Cancel button with it.
                disabled: UiState.job-queue.length > 0
                    || UiState.compat-busy
                    || UiState.creating-abadavatar
                    || UiState.abadavatar-hdd-tool-busy
                    // Expert mode decides what a connected target shows, so
                    // it is only switched with none connected.
                    || !UiState.config.target.is-empty;
                disabled-tooltip: UiState.job-queue.length > 0
                    ? "Indisponible pendant le traitement de la file"
                    : !UiState.config.target.is-empty
                        ? "Indisponible lorsqu’une destination est connectée"
                        : "Indisponible pendant l’utilisation d’un outil";
            }

            SettingCard {
                icon: IconSet.Trash;
                label: "Supprimer le fichier source après l’ajout du jeu";
                items: [{ value: "false", label: "Non (recommandé)" }, { value: "true", label: "Oui" }];
                active-item: UiState.config.remove-sources-games;
                set-property: Message.SetRemoveSourcesGames;
                disabled: UiState.job-queue.length > 0;
                disabled-tooltip: "Indisponible pendant le traitement de la file";
            }

            if UiState.config.expert-mode: SettingCard {
                icon: IconSet.Package;
                label: "Format de stockage Xbox 360";
                items: [
                    { value: "God", label: "GOD (Games On Demand, recommandé)" },
                    { value: "Xex", label: "XEX (dossier de jeu extrait, expérimental)" }
                ];
                active-item: UiState.config.xbox360-format;
                set-property: Message.SetXbox360Format;
                disabled: UiState.job-queue.length > 0;
                disabled-tooltip: "Indisponible pendant le traitement de la file";
            }

            SettingCard {
                icon: IconSet.SunMoon;
                label: "Thème";
                items: [
                    { value: "System", label: "Système (redémarrage nécessaire)" },
                    { value: "Light", label: "Clair" },
                    { value: "Dark", label: "Sombre" }
                ];
                active-item: UiState.config.theme-preference;
                set-property: Message.SetThemePreference;

                changed() => {
                    if UiState.config.theme-preference == "Light" {
                        Palette.color-scheme = ColorScheme.light;
                    } else if UiState.config.theme-preference == "Dark" {
                        Palette.color-scheme = ColorScheme.dark;
                    }
                }
            }

            if UiState.config.expert-mode: SettingCard {
                icon: IconSet.Image;
                label: "Source des jaquettes Xbox 360";
                items: [
                    { value: "XboxUnity", label: "XboxUnity (recommandé)" },
                    { value: "Mirror", label: "Miroir XboxUnity-Scraper" }
                ];
                active-item: UiState.config.cover-source;
                set-property: Message.SetCoverSource;
                note: "Ce choix concerne uniquement les jaquettes manquantes. Celles en cache sont conservées. Utilisez « Retélécharger toutes les jaquettes » dans les outils pour tout récupérer à nouveau.";
            }

            SettingCard {
                icon: IconSet.Images;
                label: "Préparer les ressources Aurora lors de l’ajout des jeux";
                items: [{ value: "false", label: "Non" }, { value: "true", label: "Oui (🧪 expérimental)" }];
                active-item: UiState.config.aurora-import-on-add;
                set-property: Message.SetAuroraImportOnAdd;
                note: "Les jaquettes, illustrations et descriptions sont copiées avec chaque jeu pour qu’Aurora les affiche sans connexion Internet. Dans Aurora, ouvrez Settings > Assets > Import.\n\nLa langue s’applique aux titres et descriptions disponibles dans cette langue sur le marché Xbox 360 (anglais sinon). Les ressources déjà préparées sont conservées.";

                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "Langue des titres et descriptions :";
                        }
                    }

                    ComboBox {
                        height: 34px;
                        horizontal-stretch: 1;
                        model: UiState.config.asset-languages;
                        // A ComboBox shows whatever `current-index` points at —
                        // assigning `current-value` does NOT move the selection.
                        current-index: UiState.config.asset-language-index;
                        selected => {
                            Dispatcher.dispatch(Message.SetAssetLanguage, self.current-index);
                        }
                    }
                }
            }

            SettingCard {
                icon: IconSet.Cable;
                label: "Se reconnecter à la dernière destination au démarrage";
                items: [
                    { value: "Never", label: "Jamais" },
                    { value: "Always", label: "Toujours" },
                    { value: "FtpOnly", label: "Seulement si la dernière connexion était en FTP" },
                    { value: "UsbOnly", label: "Seulement si la dernière destination était un disque USB" }
                ];
                active-item: UiState.config.auto-reconnect;
                set-property: Message.SetAutoReconnect;
            }

            if UiState.config.expert-mode && !UiState.config.target.is-empty: CoversCacheCard { }

            if UiState.config.expert-mode: DownloadSourcesCard { }
        }
    }
}

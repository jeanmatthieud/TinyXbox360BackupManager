import { ScrollView } from "std-widgets.slint";
import { PageHeader } from "components/page-header.slint";
import { BadAvatarCard } from "components/toolbox/badavatar-card.slint";

export component ToolboxPage inherits VerticalLayout {
    PageHeader {
        title: "Toolbox";
    }

    ScrollView {
        VerticalLayout {
            width: 100%;
            padding: 10px;
            padding-top: 0px;
            spacing: 10px;
            alignment: start;

            // Last: standalone tool, only usable when no target is connected.
            BadAvatarCard { }
        }
    }
}

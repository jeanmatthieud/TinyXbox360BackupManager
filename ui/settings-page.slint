import { ScrollView, Palette, ComboBox } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { SettingCard } from "components/setting-card.slint";
import { PageHeader } from "components/page-header.slint";
import { CoversCacheCard } from "components/toolbox/covers-cache-card.slint";
import { DownloadSourcesCard } from "components/download-sources-card.slint";
import { UiState } from "ui-state.slint";
import { Message, Dispatcher } from "messages.slint";

export component SettingsPage inherits VerticalLayout {
    PageHeader {
        title: "Settings";
    }

    ScrollView {
        VerticalLayout {
            width: 100%;
            padding: 10px;
            padding-top: 0px;
            spacing: 10px;
            alignment: start;

            SettingCard {
                icon: IconSet.FlaskConical;
                label: "Expert mode";
                items: [
                    { value: "false", label: "Off" },
                    { value: "true", label: "On" }
                ];
                active-item: UiState.config.expert-mode ? "true" : "false";
                set-property: Message.SetExpertMode;
                note: "Shows the advanced tools and settings: console hard drive access, title updates, Dashlaunch options, download sources, and more!";
                // Turning it off would hide the card of a tool still at work,
                // its status line and Cancel button with it.
                disabled: UiState.job-queue.length > 0
                    || UiState.compat-busy
                    || UiState.creating-abadavatar
                    || UiState.abadavatar-hdd-tool-busy
                    // Expert mode decides what a connected target shows, so
                    // it is only switched with none connected.
                    || !UiState.config.target.is-empty;
                disabled-tooltip: UiState.job-queue.length > 0
                    ? "Unavailable while the queue is running"
                    : !UiState.config.target.is-empty
                        ? "Unavailable while connected to a target"
                        : "Unavailable while a Toolbox tool is running";
            }

            SettingCard {
                icon: IconSet.Trash;
                label: "Delete source file when adding games";
                items: [{ value: "false", label: "No (recommended)" }, { value: "true", label: "Yes" }];
                active-item: UiState.config.remove-sources-games;
                set-property: Message.SetRemoveSourcesGames;
                disabled: UiState.job-queue.length > 0;
                disabled-tooltip: "Unavailable while the queue is running";
            }

            if UiState.config.expert-mode: SettingCard {
                icon: IconSet.Package;
                label: "Xbox 360 storage format";
                items: [
                    { value: "God", label: "GOD (Games On Demand, recommended)" },
                    { value: "Xex", label: "XEX (extracted game folder, experimental)" }
                ];
                active-item: UiState.config.xbox360-format;
                set-property: Message.SetXbox360Format;
                disabled: UiState.job-queue.length > 0;
                disabled-tooltip: "Unavailable while the queue is running";
            }

            SettingCard {
                icon: IconSet.SunMoon;
                label: "Theme";
                items: [
                    { value: "System", label: "System (requires restart)" },
                    { value: "Light", label: "Light" },
                    { value: "Dark", label: "Dark" }
                ];
                active-item: UiState.config.theme-preference;
                set-property: Message.SetThemePreference;

                changed() => {
                    if UiState.config.theme-preference == "Light" {
                        Palette.color-scheme = ColorScheme.light;
                    } else if UiState.config.theme-preference == "Dark" {
                        Palette.color-scheme = ColorScheme.dark;
                    }
                }
            }

            if UiState.config.expert-mode: SettingCard {
                icon: IconSet.Image;
                label: "Xbox 360 cover source";
                items: [
                    { value: "XboxUnity", label: "XboxUnity (recommended)" },
                    { value: "Mirror", label: "XboxUnity-Scraper mirror" }
                ];
                active-item: UiState.config.cover-source;
                set-property: Message.SetCoverSource;
                note: "Switching applies to missing covers only: already-cached covers are kept. Use \"Redownload all covers\" in the Toolbox to refetch everything.";
            }

            SettingCard {
                icon: IconSet.Images;
                label: "Prepare Aurora game assets when adding games";
                items: [{ value: "false", label: "No" }, { value: "true", label: "Yes (🧪 experimental)" }];
                active-item: UiState.config.aurora-import-on-add;
                set-property: Message.SetAuroraImportOnAdd;
                note: "Covers, artwork and descriptions are copied to the target along with each game, so Aurora can show them without the console being connected to the internet. To load them, open Aurora and go to Settings > Assets > Import.\n\nThe language applies to the titles and descriptions the Xbox 360 marketplace had in it (English otherwise). Assets already prepared are kept as they are.";

                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "Language of the titles and descriptions:";
                        }
                    }

                    ComboBox {
                        height: 34px;
                        horizontal-stretch: 1;
                        model: UiState.config.asset-languages;
                        // A ComboBox shows whatever `current-index` points at —
                        // assigning `current-value` does NOT move the selection.
                        current-index: UiState.config.asset-language-index;
                        selected => {
                            Dispatcher.dispatch(Message.SetAssetLanguage, self.current-index);
                        }
                    }
                }
            }

            SettingCard {
                icon: IconSet.Cable;
                label: "Reconnect to the last target on startup";
                items: [
                    { value: "Never", label: "Never" },
                    { value: "Always", label: "Always" },
                    { value: "FtpOnly", label: "Only if the last target was over FTP" },
                    { value: "UsbOnly", label: "Only if the last target was a USB drive" }
                ];
                active-item: UiState.config.auto-reconnect;
                set-property: Message.SetAutoReconnect;
            }

            if UiState.config.expert-mode && !UiState.config.target.is-empty: CoversCacheCard { }

            if UiState.config.expert-mode: DownloadSourcesCard { }
        }
    }
}

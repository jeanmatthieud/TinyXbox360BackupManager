import { ScrollView } from "std-widgets.slint";
import { IconDisplay, IconSet } from "@lucide";
import { MyPalette } from "styling.slint";
import { UiState } from "ui-state.slint";
import { Card } from "components/card.slint";
import { IconButton, IconButtonKind } from "components/icon-button.slint";
import { JobRow } from "components/job-row.slint";
import { JobProgressCard } from "components/job-progress-card.slint";
import {
    JobQueueToolbar,
} from "components/job-queue-toolbar.slint";
import { HorizontalLine } from "components/horizontal-line.slint";
import { EmptyState } from "components/empty-state.slint";
import { Message, Dispatcher } from "messages.slint";
import { PendingQueueAction } from "types.slint";

export component JobQueuePage inherits VerticalLayout {
    // Index of the first *pending* item: the running one (index 0) is shown in
    // its own progress card instead of being listed.
    property <int> first-pending: UiState.job-running ? 1 : 0;

    HorizontalLayout {
        padding: 10px;

        JobQueueToolbar { }
    }

    // Banner shown between the cancellation request and the moment the job
    // that was running actually stops, so the queue lingering at index 0
    // doesn't look stuck.
    if UiState.cancelling-queue: HorizontalLayout {
        padding: 10px;
        padding-top: 0px;

        Card {
            background: MyPalette.destructive.transparentize(0.9);
            border-color: MyPalette.destructive.transparentize(0.6);
            height: banner.preferred-height;

            banner := HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                cross-axis-alignment: CrossAxisAlignment.center;

                IconDisplay {
                    icon: IconSet.X;
                    stroke: MyPalette.destructive;
                    size: 14px;
                }

                Text {
                    horizontal-stretch: 1;
                    text: UiState.pending-queue-action == PendingQueueAction.Quit
                        ? "Cancelling the job in progress, the app will close once done..."
                        : (UiState.pending-queue-action == PendingQueueAction.Disconnect
                            ? "Cancelling the job in progress, the target will be disconnected once done..."
                            : "Cancelling the job in progress...");
                    color: MyPalette.destructive;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }

                // Skip the wait: carry out the pending disconnect/quit without
                // letting the running job bail out cleanly.
                if UiState.pending-queue-action != PendingQueueAction.None: IconButton {
                    horizontal-stretch: 0;
                    icon: UiState.pending-queue-action == PendingQueueAction.Quit ? IconSet.Power : IconSet.Unplug;
                    label: UiState.pending-queue-action == PendingQueueAction.Quit
                        ? "Terminate and quit"
                        : "Terminate and disconnect";
                    kind: IconButtonKind.Destructive;
                    tooltip: "Don't wait for the job in progress to stop";
                    clicked => Dispatcher.dispatch(Message.ForceQueueAction, "");
                }
            }
        }
    }

    // Nothing queued: explain the page instead of showing an empty card.
    if UiState.job-queue.length == 0: EmptyState {
        icon: IconSet.ListChecks;
        title: "The queue is empty";
        description: "Games you add or delete are handled here one at a time. Nothing is pending right now.";
    }

    if UiState.job-queue.length > 0: ScrollView {
        width: parent.width;
        viewport-height: v.preferred-height;
        // Without this the viewport would take the content's preferred width —
        // and a Text keeps the full text width as preferred width even with
        // `overflow: elide`. Long game titles would widen the whole queue
        // instead of being elided.
        viewport-width: self.visible-width;

        v := VerticalLayout {
            padding: 10px;
            padding-top: 0px;
            spacing: 10px;

            // Live progress of the job running right now.
            if UiState.job-running: JobProgressCard { }

            if UiState.job-queue.length > first-pending: Card {
                clip: true;
                height: v2.preferred-height;

                v2 := VerticalLayout {
                    for job[i] in UiState.job-queue: VerticalLayout {
                        // The running job lives in the card above, so every
                        // listed row is pending: freely removable and
                        // reorderable.
                        if i >= first-pending: VerticalLayout {
                            JobRow {
                                label: job.label;
                                kind: job.kind;
                                can-move-up: i > first-pending;
                                can-move-down: i < UiState.job-queue.length - 1;
                                // Match the card's inner curve (10px radius
                                // minus its 1px border) on the two rows that
                                // touch its rounded corners.
                                radius-top-right: i == first-pending ? 9px : 0px;
                                radius-bottom-right: i == UiState.job-queue.length - 1 ? 9px : 0px;
                                cancel() => Dispatcher.dispatch(Message.CancelJob, i);
                                move-up() => Dispatcher.dispatch(Message.MoveJobUp, i);
                                move-down() => Dispatcher.dispatch(Message.MoveJobDown, i);
                            }

                            // No separator under the last row: it would sit
                            // across the card's rounded bottom edge.
                            if i < UiState.job-queue.length - 1: HorizontalLine { }
                        }
                    }
                }
            }
        }
    }
}

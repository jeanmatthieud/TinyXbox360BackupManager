import { Modal } from "modal.slint";
import { HorizontalLine } from "horizontal-line.slint";
import { IconButton, IconButtonKind } from "icon-button.slint";
import { FatxDrivePicker } from "removable-drive-picker.slint";
import { UiState } from "../ui-state.slint";
import { Message, Dispatcher } from "../messages.slint";

// Hard-drive chooser for the BadAvatar install tool. Picks a drive for this
// one operation: it never becomes the app's target. The drive is then read
// before the confirmation modal opens.
export component BadAvatarHddTargetModal inherits Modal {
    min-w: 480px;
    min-h: 0px;
    max-h: min(620px, root.height - 75px);

    // Index into UiState.fatx-drives, -1 until the user picks one.
    property <int> selected-drive: -1;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        FatxDrivePicker {
            title: "Select the console hard drive for BadAvatar";
            selected-drive <=> root.selected-drive;
        }
    }

    VerticalLayout {
        height: self.min-height;

        HorizontalLine { }

        HorizontalLayout {
            padding: 10px;
            spacing: 8px;

            IconButton {
                label: "Close";
                clicked => {
                    UiState.selecting-badavatar-hdd-target = false;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            IconButton {
                label: "Next";
                kind: IconButtonKind.Primary;
                disabled: selected-drive < 0;
                clicked => {
                    UiState.selecting-badavatar-hdd-target = false;
                    Dispatcher.dispatch(Message.SelectBadAvatarHddDrive, UiState.fatx-drives[selected-drive].path);
                }
            }
        }
    }
}

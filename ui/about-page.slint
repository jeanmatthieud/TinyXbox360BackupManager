import { MyPalette } from "styling.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Link } from "components/link.slint";
import { Card } from "components/card.slint";
import { HorizontalLine } from "components/horizontal-line.slint";
import { UiState } from "ui-state.slint";

export component AboutPage inherits Rectangle {
    Card {
        width: 600px;
        height: self.min-height;
        x: parent.width / 2 - self.width / 2;
        y: parent.height / 2 - self.height / 2;

        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                padding: 10px;
                padding-top: 0px;
                spacing: 10px;

                Image {
                    source: @image-url("../assets/TinyXbox360BackupManager-256x256.png");
                    width: 128px;
                    height: 128px;
                }

                VerticalLayout {
                    padding: 10px;
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "TinyXbox360BackupManager v\{UiState.app-version}";
                        font-size: 18px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Copyright © 2026 Jean-Matthieu";
                    }

                    Link {
                        label: "github/jeanmatthieud";
                        uri: "https://github.com/jeanmatthieud";
                    }

                    Link {
                        label: "GPL-3.0-only";
                        uri: "https://www.gnu.org/licenses/gpl-3.0.html";
                        icon: IconSet.Scale;
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    alignment: center;

                    IconDisplay {
                        icon: IconSet.TriangleAlert;
                        stroke: MyPalette.foreground;
                    }
                }

                Text {
                    text: "TinyXbox360BackupManager is intended strictly for legal backup use and is not affiliated with or endorsed by Microsoft. Use of TinyXbox360BackupManager for pirated or unauthorized copies of games is strictly prohibited.";
                    wrap: word-wrap;
                }
            }

            HorizontalLine { }

            HorizontalLayout {
                cross-axis-alignment: CrossAxisAlignment.center;

                IconDisplay {
                    icon: IconSet.Heart;
                    stroke: MyPalette.foreground;
                    size: 15px;
                }

                Text {
                    text: " Credits";
                    font-size: 16px;
                }
            }

            Text {
                text: "This app would not exist without the work of many passionate people: the creator of TinyWiiBackupManager, the developers, sceners and communities behind the tools, exploits and databases it builds on.";
                wrap: word-wrap;
            }

            VerticalLayout {
                padding-bottom: 6px;

                Link {
                    label: "See the full credits";
                    uri: "https://github.com/jeanmatthieud/TinyXbox360BackupManager#heart-credits";
                    icon: IconSet.BookOpen;
                }
            }

            HorizontalLine { }

            HorizontalLayout {
                cross-axis-alignment: CrossAxisAlignment.center;

                IconDisplay {
                    icon: IconSet.Coffee;
                    stroke: MyPalette.foreground;
                    size: 15px;
                }

                Text {
                    text: " Support the project";
                    font-size: 16px;
                }
            }

            Text {
                text: "TinyXbox360BackupManager is free and will stay free. Donations are what make it possible for me to keep working on it — new features, fixes, and testing on real hardware.";
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 20px;
                alignment: start;

                Link {
                    label: "GitHub Sponsors";
                    uri: "https://github.com/sponsors/jeanmatthieud";
                    icon: IconSet.HandHeart;
                }

                Link {
                    label: "Ko-fi";
                    uri: "https://ko-fi.com/W6I723OON9";
                    icon: IconSet.Coffee;
                }
            }
        }
    }

    HorizontalLayout {
        width: self.min-width;
        height: self.min-height;

        x: parent.width - self.width - 15px;
        y: parent.height - self.height - 15px;

        spacing: 10px;

        Link {
            label: "Data directory";
            uri: UiState.data-dir;
            icon: IconSet.Folder;
        }

        Link {
            label: "Source code";
            uri: "https://github.com/jeanmatthieud/TinyXbox360BackupManager";
        }
    }
}

export enum Page {
    Games,
    Toolbox,
    DeviceStatus,
    ConversionQueue,
    Settings,
    About,
}

export enum TargetKind {
    Local,
    Ftp,
}

// How <TitleID> folders are arranged inside the GOD storage directory.
// Mirrors `GodLayout` in the Rust core (crates/core/src/config.rs); the
// variants must stay in the same order as the drop-down in
// components/storage-config-modal.slint.
export enum GodLayout {
    TitleId,
    NameSlashTitleId,
    NameDashTitleId,
    TitleIdDashName,
}

// Action the user asked for while the conversion queue was still busy: it is
// held back until the queue has been cancelled and fully drained.
export enum PendingQueueAction {
    None,
    Disconnect,
    Quit,
}

export struct DisplayedConfig {
    path: string,
    // Displayed target: local path or ftp://ip. Empty if no target.
    target: string,
    target-kind: TargetKind,
    mount-point: string,
    remove-sources-games: string,
    xbox360-format: string,
    sort-by: string,
    view-as: string,
    theme-preference: string,
    auto-reconnect: string,
    show-x360: bool,
    show-arcade: bool,
    show-og: bool,
    console-ip: string,
    ftp-port: string,
    ftp-user: string,
    ftp-password: string,
}

export struct DisplayedBadAvatarConfig {
    // Effective URLs (user override or built-in default) shown in the fields.
    abadavatar-url: string,
    xeunshackle-url: string,
    aurora-url: string,
    system-update-url: string,
    // Built-in default URLs, so each field can offer a reset when it differs.
    abadavatar-default-url: string,
    xeunshackle-default-url: string,
    aurora-default-url: string,
    system-update-default-url: string,
    include-system-update: bool,
}

export struct DisplayedRecentLocation {
    // Folder name (local drive) or IP (console over FTP).
    name: string,
    is-ftp: bool,
}

// A local drive offered in the target-selection modal: a removable device or
// any non-system disk. See `txbm_core::drives`.
export struct DisplayedRemovableDrive {
    // Volume label / mount name.
    name: string,
    // Mount root, used as the library location (dispatched on selection).
    mount-point: string,
    // Preformatted "X free of Y", empty when the size is unknown.
    size-text: string,
    // True when the OS flags the drive as removable (drives the shown icon).
    is-removable: bool,
    // Filesystem name ("FAT32", "exFAT", "NTFS", …).
    fs-label: string,
    // True only for FAT32: the sole filesystem the console reads. Non-FAT32
    // drives are shown but disabled.
    is-fat32: bool,
}

// One entry of the "add these conversions to the queue?" confirmation.
export struct DisplayedGameToAdd {
    // Source file name.
    name: string,
    // True when a game with the same TitleID is already installed on the
    // target: queueing this one overwrites it. Detected before the queue is
    // confirmed, from the already-scanned library (no extra I/O).
    already-installed: bool,
    // Title of the game it would overwrite, empty when `already-installed`
    // is false.
    installed-title: string,
}

export struct DisplayedGame {
    path: string,
    is-x360: bool,
    is-arcade: bool,
    format: string,
    size-gib: float,
    title: string,
    id: string,
    cover: image,
    // True when only DLC and/or a title update are installed, with no
    // actual game package (base install removed or never completed).
    incomplete: bool,
}

// Status of one stored component (disc / DLC / title update) shown in the
// game info modal's table.
export enum ComponentStatus {
    // Present and its STFS header parses cleanly.
    Installed,
    // STFS header couldn't be read (missing magic / interrupted upload).
    Corrupted,
    // Expected but absent (e.g. only DLC installed, base game disc missing).
    Missing,
    // Currently being transferred (reserved; wired up later).
    Uploading,
}

// One row of the game info modal's stored-components table.
export struct DisplayedGameComponent {
    // "Disc", "DLC", or "TU" — drives the row icon and label.
    kind: string,
    // On-disk file name of the package, used to delete it. Empty for the
    // synthetic "Missing" row (which has nothing to delete).
    id: string,
    // e.g. "Disc 1 · 545408A7" or the DLC display name.
    description: string,
    size-gib: float,
    status: ComponentStatus,
}

export struct DisplayedTitleUpdate {
    id: string,
    hash: string,
    name: string,
    version: string,
    size-text: string,
    // File name under 000B0000 when installed, empty otherwise.
    installed-file-name: string,
    is-active: bool,
    // True if Aurora already downloaded this update into its own cache
    // (the only case in which this app can activate it).
    is-cached: bool,
}

// One folder this app installs/scans on the console, and whether Aurora is
// configured to scan it (or an ancestor).
export struct DisplayedStoragePath {
    label: string,
    // FTP path (/Device/dir/…).
    path: string,
    // Same location in Aurora's "Manage Paths" format (Device:\dir\…).
    aurora-path: string,
    covered: bool,
}

export struct DisplayedDriveInfo {
    label: string,
    used-gib: float,
    games-gib: float,
    total-gib: float,
    fs-kind: string,
    allocation-granularity: int,
}

// Tone of a notification: picks its icon and accent colour.
export enum NotificationKind {
    Info,
    Success,
    Error,
}

export struct Notification {
    // Stable identity, handed out by the Rust side. Toasts dismiss themselves
    // by id rather than by row: several can time out in the same frame, and
    // the first removal would shift the others' indices.
    id: int,
    text: string,
    kind: NotificationKind,
}

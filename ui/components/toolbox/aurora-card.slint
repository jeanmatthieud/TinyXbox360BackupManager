import { Icon, IconSet, IconDisplay } from "@lucide";
import { Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { IconButton } from "../icon-button.slint";
import { InfoNote } from "../info-note.slint";
import { MyPalette } from "../../styling.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";
import { TargetKind } from "../../types.slint";

// Heading of one of the card's sections: a small icon and a bold title.
component SectionTitle inherits HorizontalLayout {
    in property <Icon> icon;
    in property <string> title;

    spacing: 6px;
    alignment: start;
    cross-axis-alignment: CrossAxisAlignment.center;

    IconDisplay {
        icon: root.icon;
        stroke: MyPalette.foreground;
        size: 14px;
    }

    Text {
        text: root.title;
        font-weight: 600;
    }
}

// One of the numbered steps of a how-to: the number in the accent colour, then
// what to do.
component Step inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;

    spacing: 8px;

    Text {
        text: root.number;
        font-weight: 700;
        color: MyPalette.accent-background;
        vertical-alignment: top;
    }

    Text {
        text: root.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// Aurora on the target, one section per concern: the paths it scans, then the
// game assets handed to it.
export component AuroraCard inherits ToolboxCard {
    // Games of the library still without a folder in Aurora's import folder.
    property <int> import-remaining: UiState.aurora-import-total - UiState.aurora-import-ready;

    CardHeader {
        icon: IconSet.LayoutDashboard;
        title: "Aurora";

        if UiState.fetching-aurora-paths: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }

        // Every console-shaped target, FATX included: the page itself is shown
        // for both (see device-status-page.slint), so both need the refresh.
        if UiState.config.target-kind != TargetKind.Local && !UiState.fetching-aurora-paths: IconButton {
            icon: IconSet.RefreshCcw;
            width: self.height;
            clicked => {
                if !UiState.fetching-aurora-paths {
                    Dispatcher.dispatch(Message.FetchAuroraPaths, "");
                }
            }
        }
    }

    HorizontalLine { }

    // ---- Scan paths: the paths Aurora is actually scanning, with guidance
    // when none are set or when the read failed.

    SectionTitle {
        icon: IconSet.FolderSearch;
        title: "Chemins d’analyse";
    }

    if UiState.fetching-aurora-paths && !UiState.aurora-paths-loaded: Text {
        text: "Lecture des chemins d’analyse d’Aurora…";
    }

    // Read failure: reported here, not as a notification.
    if !UiState.fetching-aurora-paths && UiState.aurora-paths-error != "": VerticalLayout {
        spacing: 5px;

        HorizontalLayout {
            spacing: 5px;
            cross-axis-alignment: CrossAxisAlignment.center;

            IconDisplay {
                icon: IconSet.TriangleAlert;
                stroke: MyPalette.destructive;
                size: 14px;
            }

            Text {
                text: "Impossible de lire les chemins d’analyse d’Aurora.";
                color: MyPalette.destructive;
            }
        }

        Text {
            text: UiState.aurora-paths-error;
            font-size: 12px;
            wrap: word-wrap;
            color: MyPalette.foreground.transparentize(0.4);
        }
    }

    // Aurora scans nothing yet: warn and offer guidance.
    if UiState.aurora-paths-error == "" && UiState.aurora-paths-loaded && UiState.aurora-scan-paths.length == 0: VerticalLayout {
        height: self.min-height;
        spacing: 8px;

        HorizontalLayout {
            spacing: 5px;
            cross-axis-alignment: CrossAxisAlignment.center;

            IconDisplay {
                icon: IconSet.TriangleAlert;
                stroke: #e0a12f;
                size: 14px;
            }

            Text {
                text: "Aucun dossier n’est analysé par Aurora.";
                color: #e0a12f;
            }
        }

        Text {
            text: "Ajoutez dans Aurora les chemins d’analyse de vos jeux Xbox 360 (GOD) et Xbox originale pour les faire apparaître. Faites-le sur la console, puis actualisez ici.";
            wrap: word-wrap;
        }

        CardActionRow {
            icon: IconSet.CircleQuestionMark;
            text: "Aide pour ajouter les chemins dans Aurora";
            clicked => { UiState.showing-aurora-help = true };
        }
    }

    if !UiState.fetching-aurora-paths && UiState.aurora-scan-paths.length > 0: VerticalLayout {
        spacing: 3px;

        Text {
            text: "Aurora analyse les chemins suivants :";
        }

        for path in UiState.aurora-scan-paths: Text {
            text: "- " + path;
            font-size: 12px;
        }
    }

    // ---- Game assets: written into Aurora's import folder, which Aurora
    // only reads when asked to. Hidden without an Aurora to write to.

    if UiState.aurora-install-dir != "": HorizontalLine { }

    if UiState.aurora-install-dir != "": SectionTitle {
        icon: IconSet.Images;
        title: "Ressources des jeux";
    }

    // Pinned to its min-height, like every wrapped text in the cards: left to
    // its preferred height, a wrapped text counts a single line, and the card
    // comes out too short for what follows.
    if UiState.aurora-install-dir != "": VerticalLayout {
        height: self.min-height;
        spacing: 10px;

        Text {
            text: "Préparez les ressources de vos jeux pour qu’Aurora les affiche sans connexion Internet. Deux étapes :";
            wrap: word-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            Step {
                number: "1";
                text: "Préparez les fichiers ici. Ils seront copiés dans le dossier d’importation d’Aurora.";
            }

            Step {
                number: "2";
                text: "Sur la console, ouvrez Aurora : Settings > Assets > Import.";
            }
        }

        // Aurora never removes the files and applies them on every run.
        InfoNote {
            text: "Chaque importation remplace les ressources affichées pour ces jeux, y compris vos personnalisations dans Aurora.";
        }
    }

    if UiState.aurora-install-dir != "": CardActionRow {
        icon: IconSet.ImagePlus;
        text: root.import-remaining == 1
            ? "Préparer les ressources Aurora du jeu restant"
            : root.import-remaining > 1
            ? "Préparer les ressources Aurora des " + root.import-remaining + " jeux restants"
            : "Préparer les ressources Aurora";
        disabled: root.import-remaining <= 0 || UiState.fetching-aurora-paths;
        tooltip: root.import-remaining > 0
            ? "Les jeux déjà préparés sont conservés"
            : UiState.aurora-import-total == 0
            ? "Ajoutez d’abord des jeux"
            : "Tout est déjà prêt";
        clicked => {
            Dispatcher.dispatch(Message.PrepareAuroraImport, "");
        }
    }

    if UiState.aurora-install-dir != "": CardActionRow {
        icon: IconSet.Trash;
        text: "Supprimer les ressources Aurora à importer";
        disabled: UiState.aurora-import-folders <= 0 || UiState.fetching-aurora-paths;
        tooltip: UiState.aurora-import-folders > 0
            ? "Vide le dossier d’importation d’Aurora. Les ressources déjà importées sont conservées."
            : "Le dossier d’importation d’Aurora est vide";
        clicked => {
            UiState.confirming-clear-aurora-import = true;
        }
    }

    // Shown with the footnote only, so the card never ends on a bare line.
    if !UiState.fetching-aurora-paths && UiState.aurora-install-dir != "": HorizontalLine { }

    // Quiet footnote, styled like the launch.ini location on the Dashlaunch card.
    if !UiState.fetching-aurora-paths && UiState.aurora-install-dir != "": HorizontalLayout {
        spacing: 5px;
        cross-axis-alignment: CrossAxisAlignment.center;

        IconDisplay {
            icon: IconSet.Folder;
            stroke: MyPalette.foreground.transparentize(0.5);
            size: 12px;
        }

        Text {
            text: "Aurora trouvé dans : " + UiState.aurora-install-dir;
            font-size: 11px;
            wrap: word-wrap;
            horizontal-stretch: 1;
            color: MyPalette.foreground.transparentize(0.5);
        }
    }

    // How far the library is prepared, in the same quiet style.
    if !UiState.fetching-aurora-paths && UiState.aurora-install-dir != "" && UiState.aurora-import-total > 0: HorizontalLayout {
        spacing: 5px;
        cross-axis-alignment: CrossAxisAlignment.center;

        IconDisplay {
            icon: IconSet.Images;
            stroke: MyPalette.foreground.transparentize(0.5);
            size: 12px;
        }

        Text {
            text: "Ressources Aurora prêtes à importer : " + UiState.aurora-import-ready + " sur " + UiState.aurora-import-total + (UiState.aurora-import-total == 1 ? " jeu" : " jeux");
            font-size: 11px;
            wrap: word-wrap;
            horizontal-stretch: 1;
            color: MyPalette.foreground.transparentize(0.5);
        }
    }
}

import { IconSet } from "@lucide";
import { Page } from "../types.slint";
import { NavbarButton } from "navbar-button.slint";
import { UiState } from "../ui-state.slint";
import { Message, Dispatcher } from "../messages.slint";

export component Navbar inherits VerticalLayout {
    alignment: LayoutAlignment.space-between;

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        NavbarButton {
            active: UiState.current-page == Page.Games;
            icon: IconSet.Gamepad2;
            tooltip: "Jeux";
            clicked => {
                UiState.current-page = Page.Games;
            }
        }

        // Storage / health report of the target. Always available: with no
        // target it explains how to connect one.
        NavbarButton {
            active: UiState.current-page == Page.DeviceStatus;
            icon: IconSet.HardDrive;
            tooltip: "État du stockage";
            clicked => {
                UiState.current-page = Page.DeviceStatus;
            }
        }

        // Always reachable (the page explains itself when empty); the icon
        // only spins while a job is actually running.
        NavbarButton {
            active: UiState.current-page == Page.Jobs;
            icon: IconSet.RefreshCw;
            tooltip: UiState.job-queue.length > 0
                ? "File (\{UiState.job-queue.length})"
                : "File d’attente";
            rotate: UiState.job-running;
            clicked => {
                UiState.current-page = Page.Jobs;
            }
        }

        // No target may be picked while a Toolbox tool is working on a console
        // of its own: both write outside the job queue, and a job started here
        // would be a second write in flight (see `crates/core/src/ftp.rs`).
        if UiState.config.target.is-empty: NavbarButton {
            icon: IconSet.Zap;
            ping: !UiState.creating-abadavatar && !UiState.compat-busy && !UiState.abadavatar-hdd-tool-busy;
            disabled: UiState.creating-abadavatar || UiState.compat-busy || UiState.abadavatar-hdd-tool-busy;
            tooltip: UiState.creating-abadavatar
                ? "Création de la clé USB ABadAvatar en cours"
                : UiState.compat-busy
                    ? "Installation de la rétrocompatibilité Xbox originale en cours"
                    : UiState.abadavatar-hdd-tool-busy
                        ? "Installation d’ABadAvatar sur disque dur en cours"
                        : "Choisir une destination";
            clicked => {
                UiState.selecting-target = true;
            }
        }

        if !UiState.config.target.is-empty: NavbarButton {
            icon: IconSet.Unplug;
            // The hard drive must not be let go while ABadAvatar is being
            // written to it or removed from it.
            disabled: UiState.abadavatar-hdd-busy;
            tooltip: UiState.abadavatar-hdd-busy
                ? "Attendez la fin du retrait d’ABadAvatar du disque dur"
                : "Déconnecter \{UiState.config.target}";
            clicked => Dispatcher.dispatch(Message.RequestDisconnect, "");
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        if !UiState.latest-version.is-empty: NavbarButton {
            icon: IconSet.BellPlus;
            tooltip: "Nouvelle version officielle (en anglais) : \{UiState.latest-version}";
            clicked => Dispatcher.dispatch(Message.OpenThat, "https://github.com/jeanmatthieud/TinyXbox360BackupManager/releases/latest");
        }

        // Always available: the Toolbox hosts the ABadAvatar USB-key creation,
        // which is useful even when no target is connected.
        NavbarButton {
            active: UiState.current-page == Page.Toolbox;
            icon: IconSet.ToolCase;
            tooltip: "Outils";
            clicked => {
                UiState.current-page = Page.Toolbox;
            }
        }

        NavbarButton {
            active: UiState.current-page == Page.Settings;
            icon: IconSet.Settings;
            tooltip: "Paramètres";
            clicked => {
                UiState.current-page = Page.Settings;
            }
        }

        NavbarButton {
            active: UiState.current-page == Page.About;
            icon: IconSet.Info;
            tooltip: "À propos de TinyXbox360BackupManager FR";
            clicked => {
                UiState.current-page = Page.About;
            }
        }
    }
}

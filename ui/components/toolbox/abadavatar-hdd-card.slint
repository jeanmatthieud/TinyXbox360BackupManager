import { IconSet, IconDisplay } from "@lucide";
import { Spinner } from "std-widgets.slint";
import { ToolboxCard } from "../toolbox-card.slint";
import { CardHeader } from "../card-header.slint";
import { CardActionRow } from "../card-action-row.slint";
import { HorizontalLine } from "../horizontal-line.slint";
import { IconButton } from "../icon-button.slint";
import { WarningNote } from "../warning-note.slint";
import { MyPalette } from "../../styling.slint";
import { UiState } from "../../ui-state.slint";
import { Message, Dispatcher } from "../../messages.slint";
import { ABadAvatarHddState } from "../../types.slint";

// A quiet explanatory line.
component Hint inherits Text {
    font-size: 12px;
    wrap: word-wrap;
    color: MyPalette.foreground.transparentize(0.35);
}

// ABadAvatar on the connected console hard drive (FATX target only): its state,
// and the removal of our own install. Someone else's setup is only reported,
// and the install itself is a Toolbox tool (it needs no target connected).
// The removal bypasses the job queue, so the card is veiled while a job runs
// (and the queue waits for the removal in turn).
export component ABadAvatarHddCard inherits ToolboxCard {
    private property <ABadAvatarHddState> state: UiState.abadavatar-hdd.state;

    disabled: (UiState.job-running || UiState.writing-dashlaunch) && !UiState.abadavatar-hdd-busy;
    disabled-tooltip: "Disponible lorsque la file d’attente sera terminée.";

    CardHeader {
        icon: IconSet.HardDrive;
        title: "ABadAvatar sur le disque dur";

        if UiState.abadavatar-hdd-busy: Spinner {
            width: 27px;
            height: 27px;
            indeterminate: true;
        }

        if !UiState.abadavatar-hdd-busy: IconButton {
            icon: IconSet.RefreshCcw;
            width: self.height;
            tooltip: "Relire le disque dur";
            clicked => Dispatcher.dispatch(Message.FetchABadAvatarHdd, "");
        }
    }

    HorizontalLine { }

    // Each piece sits directly in the card's own layout rather than in a
    // nested one per state: a wrapped Text only gets the height of its wrapped
    // lines from the layout that sets its width.

    // Retail: nothing to do here; the install is a Toolbox tool.
    if state == ABadAvatarHddState.Retail: Text {
        text: "ABadAvatar n’est pas installé sur ce disque dur.";
        wrap: word-wrap;
    }

    if state == ABadAvatarHddState.Retail: Hint {
        text: "Pour l’installer, déconnectez ce disque, puis utilisez « ABadAvatar sur un disque dur de console » dans les outils.";
    }

    // Ours: installed, or only partly.
    if state == ABadAvatarHddState.Installed: HorizontalLayout {
        spacing: 8px;

        IconDisplay {
            icon: IconSet.ShieldCheck;
            stroke: MyPalette.success;
            size: 16px;
        }

        Text {
            text: "ABadAvatar est installé sur ce disque dur.";
            horizontal-stretch: 1;
        }
    }

    if state == ABadAvatarHddState.Incomplete: WarningNote {
        text: "ABadAvatar est partiellement installé : une installation a été interrompue ou des fichiers ont été supprimés. Retirez-le puis réinstallez-le.";
    }

    if state == ABadAvatarHddState.Installed: Hint {
        text: "Il se déclenche à chaque démarrage, à l’écran des profils. Pour démarrer sans lui, maintenez B pendant le chargement de cet écran. Retirez toute clé USB ABadAvatar : la console la recherche en priorité.";
    }

    // Someone else's setup: reported only.
    if state == ABadAvatarHddState.Foreign: WarningNote {
        text: "Une autre installation d’ABadAvatar ou de BadUpdate est présente sur ce disque :";
    }

    for item in (state == ABadAvatarHddState.Foreign ? UiState.abadavatar-hdd.found : []): Text {
        text: "  • " + item;
        font-size: 12px;
        font-family: "monospace";
        wrap: word-wrap;
    }

    if state == ABadAvatarHddState.Foreign: Hint {
        text: "Rétablissez l’état d’origine du disque en retirant ces fichiers avant d’installer la version proposée dans les outils.";
    }

    // Bad Storage: the console only reads this drive once the exploit has run.
    if state == ABadAvatarHddState.BadStorage: HorizontalLayout {
        spacing: 8px;

        IconDisplay {
            icon: IconSet.ShieldX;
            stroke: MyPalette.destructive;
            size: 16px;
        }

        Text {
            text: "Ce disque est formaté pour Bad Storage, qui ne peut pas cohabiter avec ABadAvatar.";
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }

    if state == ABadAvatarHddState.BadStorage: Hint {
        text: "La console lit ce disque seulement après l’exécution de l’exploit : celui-ci ne peut donc pas démarrer depuis ce disque. Gardez ABadAvatar sur sa clé USB.";
    }

    if state == ABadAvatarHddState.Installed || state == ABadAvatarHddState.Incomplete: HorizontalLine { }

    if state == ABadAvatarHddState.Installed || state == ABadAvatarHddState.Incomplete: CardActionRow {
        icon: IconSet.Trash2;
        text: UiState.abadavatar-hdd-busy ? "En cours… consultez la barre d’état en bas." : "Retirer ABadAvatar de ce disque dur";
        disabled: UiState.abadavatar-hdd-busy;
        clicked => Dispatcher.dispatch(Message.UninstallABadAvatarHdd, "");
    }
}

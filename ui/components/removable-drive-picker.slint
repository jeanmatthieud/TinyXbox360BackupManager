import { IconButton } from "icon-button.slint";
import { TooltipArea } from "tooltip-area.slint";
import { Link } from "link.slint";
import { Icon, IconSet, IconDisplay } from "@lucide";
import { MyPalette } from "../styling.slint";
import { UiState } from "../ui-state.slint";
import { Message, Dispatcher } from "../messages.slint";

// A large, selectable tile (icon + title + subtitle). Selecting it (a click)
// does not act on its own: it lights up so the surrounding view can enable a
// confirm action. Inherits TooltipArea to reuse its click / long-press handling.
export component SelectableCard inherits TooltipArea {
    in property <Icon> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected: false;

    height: 62px;
    border-radius: 10px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? MyPalette.accent-background : MyPalette.border;
    background: selected ? MyPalette.selection-background
        : (self.has-hover ? MyPalette.alternate-background : MyPalette.background);

    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        cross-axis-alignment: center;

        IconDisplay {
            icon: root.icon;
            stroke: MyPalette.foreground;
            size: 26px;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: title;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: subtitle;
                font-size: 12px;
                color: MyPalette.foreground.transparentize(0.4);
                overflow: elide;
            }
        }
    }
}

// The removable-drive chooser: a header with a Refresh button, an empty state,
// and one SelectableCard per detected drive (non-FAT32 drives disabled, as the
// console requires FAT32). Reads `UiState.removable-drives`; the parent view
// owns `selected-drive` (an index into that list, -1 when nothing is picked)
// and provides the surrounding confirm/cancel buttons.
export component RemovableDrivePicker inherits VerticalLayout {
    in property <string> title: "Choisir un disque amovible";
    // Index of the drive picked (into UiState.removable-drives), -1 until the
    // user makes an explicit choice. Bound two-way by the parent.
    in-out property <int> selected-drive: -1;

    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;
        padding-bottom: 10px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-size: 18px;
                overflow: elide;
            }
        }

        IconButton {
            icon: IconSet.RefreshCw;
            tooltip: "Actualiser";
            width: 30px;
            clicked => {
                root.selected-drive = -1;
                Dispatcher.dispatch(Message.RefreshRemovableDrives, "");
            }
        }
    }

    if UiState.removable-drives.length == 0: VerticalLayout {
        spacing: 6px;

        Text {
            text: "Aucun disque amovible détecté.";
            color: MyPalette.foreground.transparentize(0.3);
        }

        Text {
            text: "Branchez une clé USB ou un disque externe, puis actualisez.";
            color: MyPalette.foreground.transparentize(0.5);
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    for drive[i] in UiState.removable-drives: SelectableCard {
        icon: drive.is-removable ? IconSet.Usb : IconSet.HardDrive;
        title: drive.name;
        subtitle: drive.is-fat32
            ? (drive.size-text == "" ? "FAT32" : drive.size-text + "  ·  FAT32")
            : drive.fs-label + " — non pris en charge (FAT32 requis)";
        selected: root.selected-drive == i;
        // Only FAT32 drives are usable by the console.
        disabled: !drive.is-fat32;
        clicked => {
            root.selected-drive = i;
        }
    }
}

// The Xbox 360 hard-drive chooser. Same shape as the removable-drive picker
// above, over `UiState.fatx-drives`: disks that do not actually hold an
// Xbox 360 filesystem are listed but disabled, with the reason as their
// subtitle — a disk missing from the list is far more puzzling than a disk
// shown greyed out next to "access denied".
export component FatxDrivePicker inherits VerticalLayout {
    in property <string> title: "Choisir un disque dur Xbox 360";
    in-out property <int> selected-drive: -1;

    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;
        padding-bottom: 10px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-size: 18px;
                overflow: elide;
            }
        }

        IconButton {
            icon: IconSet.RefreshCw;
            tooltip: "Actualiser";
            width: 30px;
            disabled: UiState.scanning-fatx-drives;
            clicked => {
                root.selected-drive = -1;
                Dispatcher.dispatch(Message.RefreshFatxDrives, "");
            }
        }
    }

    // Probing every disk of the machine is slow enough to be worth saying so.
    if UiState.scanning-fatx-drives: Text {
        text: "Recherche de disques durs Xbox 360…";
        color: MyPalette.foreground.transparentize(0.3);
    }

    if !UiState.scanning-fatx-drives && UiState.fatx-drives.length == 0: VerticalLayout {
        spacing: 6px;
        padding-bottom: 10px;

        Text {
            text: "Aucun disque dur Xbox 360 détecté.";
            color: MyPalette.foreground.transparentize(0.3);
        }

        Text {
            text: "Branchez le disque de la console (adaptateur SATA ou USB), puis actualisez. "
                + "L’accès direct à un disque nécessite des droits spécifiques.";
            color: MyPalette.foreground.transparentize(0.5);
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    for drive[i] in UiState.fatx-drives: SelectableCard {
        icon: IconSet.HardDrive;
        title: drive.name;
        subtitle: drive.size-text == "" ? drive.detail : drive.size-text + "  ·  " + drive.detail;
        selected: root.selected-drive == i;
        disabled: !drive.usable;
        clicked => {
            root.selected-drive = i;
        }
    }

    // Missing privileges is the one failure the user can fix, and the fix is
    // platform-specific, so point at the README section for this build's OS
    // (see `config::fatx_privileges_help_url`). Also offered when nothing was
    // found at all: an unreadable disk can be missing from the list entirely.
    if !UiState.scanning-fatx-drives
        && (UiState.fatx-access-denied || UiState.fatx-drives.length == 0): VerticalLayout {
        padding-top: 4px;

        Link {
            label: "Comment obtenir les droits nécessaires ?";
            uri: UiState.fatx-privileges-help-url;
            icon: IconSet.ShieldQuestionMark;
        }
    }
}

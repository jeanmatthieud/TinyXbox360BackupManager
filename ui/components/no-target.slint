import { IconSet } from "@lucide";
import { EmptyState } from "empty-state.slint";
import { UiState } from "../ui-state.slint";

// Shown by every page that needs a target while none is connected. Pages only
// override `description` to say what they would show once connected.
export component NoTarget inherits EmptyState {
    boxed: true;
    icon: IconSet.HardDrive;
    title: "No target connected";
    description: "Connect a USB drive or your console to browse and manage its games";
    action-icon: IconSet.Zap;
    // Same rule as the navbar: no target picking while a Toolbox tool is
    // busy with a console of its own.
    action-label: UiState.creating-badavatar || UiState.compat-busy || UiState.badavatar-hdd-tool-busy
        ? ""
        : "Select a target";
    action => {
        UiState.selecting-target = true;
    }
}

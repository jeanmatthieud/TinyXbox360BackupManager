import { ScrollView } from "std-widgets.slint";
import { PageHeader } from "components/page-header.slint";
import { ABadAvatarCard } from "components/toolbox/abadavatar-card.slint";
import { OgXboxCompatCard } from "components/toolbox/ogxbox-compat-card.slint";
import { ABadAvatarHddInstallCard } from "components/toolbox/abadavatar-hdd-install-card.slint";
import { UiState } from "ui-state.slint";

export component ToolboxPage inherits VerticalLayout {
    PageHeader {
        title: "Toolbox";
    }

    ScrollView {
        VerticalLayout {
            width: 100%;
            padding: 10px;
            padding-top: 0px;
            spacing: 10px;
            alignment: start;

            // Standalone tools, only usable when no target is connected: each
            // picks the console (or the USB key) it works on by itself.
            
            ABadAvatarCard { }

            if UiState.config.expert-mode: ABadAvatarHddInstallCard { }

            OgXboxCompatCard { }
        }
    }
}

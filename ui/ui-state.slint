import {
    DisplayedBadAvatarConfig,
    DisplayedConfig,
    DisplayedDriveInfo,
    DisplayedFatxDrive,
    DisplayedGame,
    DisplayedGameComponent,
    DisplayedGameToAdd,
    DisplayedJob,
    DisplayedRecentLocation,
    DisplayedRemovableDrive,
    DisplayedStoragePath,
    DisplayedTitleUpdate,
    GodLayout,
    JobKind,
    Notification,
    Page,
    PendingQueueAction,
} from "types.slint";

export global UiState {
    in-out property <Page> current-page: Page.Games;
    in-out property <DisplayedGame> current-game;
    in-out property <DisplayedGame> game-to-delete;
    // Stored components (discs, DLC, and a "Missing" placeholder for an
    // absent base disc) for `current-game`, one row per item, fetched on
    // demand when its info modal is opened (may involve an FTP round-trip).
    in-out property <[DisplayedGameComponent]> current-game-components;
    // Set to the component the user asked to delete (from the info modal's
    // per-row trash button): shows a confirmation without closing the info
    // modal. `id == ""` means no deletion pending.
    in-out property <DisplayedGameComponent> content-to-delete;
    in-out property <bool> fetching-game-details: false;

    // Title Updates window for `current-game`, opened separately from a
    // button on the info modal (only fetched then: it needs an XboxUnity
    // HTTP call on top of the FTP round-trip).
    in-out property <bool> showing-title-updates: false;
    in-out property <[DisplayedTitleUpdate]> title-updates;
    in-out property <bool> fetching-title-updates: false;
    // True while a title update is being activated/deactivated.
    in-out property <bool> updating-title-update: false;

    in-out property <bool> selecting-target: false;
    in-out property <bool> editing-ftp-target: false;

    // Storage-configuration modal, shown after connecting to a target that has
    // no `.txbm.json` yet: lets the user confirm where GOD and extracted games
    // are stored before scanning.
    in-out property <bool> configuring-storage: false;
    // True while the target is being analyzed, or the choice applied (spinner).
    in-out property <bool> analyzing-target: false;
    // True when the current target is a console over FTP (free-text entry) vs a
    // local drive (system folder picker) for the "other location" case.
    in-out property <bool> storage-is-console: false;
    // Candidate directories discovered on the target, offered in the drop-downs.
    in-out property <[string]> storage-candidates;
    // Chosen install destinations (the source of truth on confirm).
    in-out property <string> storage-god-dir;
    // Extracted Original Xbox (XBE) and Xbox 360 (XEX) destinations.
    in-out property <string> storage-xbe-dir;
    in-out property <string> storage-xex-dir;
    // How <TitleID> folders are arranged inside the GOD storage dir. Per-target,
    // stored in the `.txbm.json` manifest alongside the three directories above.
    in-out property <GodLayout> storage-god-layout;
    // FTP modal: true while the local network is being scanned for a console.
    in-out property <bool> ftp-scanning: false;
    // FTP modal: IP of the console found by the scan (empty if none/not yet).
    in-out property <string> ftp-scan-found-ip: "";
    // FTP modal: true once the user switches to the manual-entry form.
    in-out property <bool> ftp-show-manual: false;
    // Most-recently-used library locations (most recent first, max 5),
    // shown in the target-selection modal.
    in-out property <[DisplayedRecentLocation]> recent-locations;
    // Local drives offered when picking a removable target (populated on
    // demand by the RefreshRemovableDrives message).
    in-out property <[DisplayedRemovableDrive]> removable-drives;

    // Raw disks that may hold an Xbox 360 filesystem, for the FATX picker.
    in-out property <[DisplayedFatxDrive]> fatx-drives;

    in-out property <DisplayedConfig> config;
    in-out property <string> app-version;
    in-out property <string> data-dir;
    in-out property <DisplayedDriveInfo> drive-info;
    in-out property <[DisplayedGame]> games;
    // True when the (unfiltered) library holds at least one game, so the grid
    // can tell an empty library apart from all games being hidden by filters.
    in-out property <bool> has-games: false;
    in-out property <[Notification]> notifications;
    // Every operation that writes to the target — additions and deletions
    // alike — waits its turn here. The entry at index 0 is the running one.
    in-out property <[DisplayedJob]> job-queue;
    in-out property <[DisplayedGameToAdd]> games-to-add;
    // How many `games-to-add` entries would overwrite an installed game.
    // Counted on the Rust side: Slint models can't be folded over.
    in-out property <int> games-to-add-conflicts: 0;
    in-out property <string> status;
    in-out property <string> latest-version;
    // True while downloading missing covers.
    in-out property <bool> downloading-covers: false;
    // True during target scan (cancellable).
    in-out property <bool> scanning: false;
    // True while a job is running (the item at index 0 of job-queue is the
    // one currently running).
    in-out property <bool> job-running: false;
    // Live progress of the job at index 0, shown as a card on the queue page.
    // Kept as structured data (rather than parsed back out of `status`) so the
    // progress bar and the status line can diverge in wording.
    // Name of the file/game the job works on.
    in-out property <string> job-label;
    // What that job does, for the card's icon and wording.
    in-out property <JobKind> job-kind: JobKind.Add;
    // 0.0 - 1.0.
    in-out property <float> job-progress: 0;
    // Running average upload speed, pre-formatted (e.g. "24.3 MB/s"). Empty
    // outside the FTP upload phase, where no speed is measured (deletions
    // never measure one).
    in-out property <string> job-speed;
    // Short label for the step the percentage currently refers to (GOD
    // conversion, extraction, upload), or for a phase with no measurable
    // progress at all (post-cancellation cleanup). Empty in between.
    in-out property <string> job-phase;
    // True between "cancel this job" on the running item and the moment it
    // actually bails out. Unlike cancelling-queue, the pending items stay.
    in-out property <bool> cancelling-current: false;
    // True for the duration of the confetti burst played when the queue drains
    // after at least one successful addition. Set by the update loop, cleared
    // by the animation itself once it has finished.
    in-out property <bool> celebrating: false;
    // True while the "cancel all jobs" confirmation modal is shown.
    in-out property <bool> confirming-cancel-all: false;
    // True while the "cancel the job in progress" confirmation modal is shown
    // (the pending items are left alone by that one).
    in-out property <bool> confirming-cancel-current: false;
    // True between "cancel all jobs" and the moment the job that was running
    // actually bails out (the queue is empty again).
    in-out property <bool> cancelling-queue: false;
    // Action (disconnect / quit) requested while the queue was still busy. It
    // drives the "cancel the queue first?" confirmation modal, and is replayed
    // once the queue is empty. `None` means nothing is pending.
    in-out property <PendingQueueAction> pending-queue-action: PendingQueueAction.None;
    // True once the user confirmed: the queue is being cancelled and the
    // pending action is waiting for it to drain.
    in-out property <bool> draining-queue: false;
    // Locations currently scanned by Aurora on the console, as displayed
    // lines (fetched from its databases over FTP).
    in-out property <[string]> aurora-scan-paths;
    // Where the Aurora installation itself was found (e.g. "/Hdd1/Aurora").
    // Empty when not detected.
    in-out property <string> aurora-install-dir;
    // True while fetching aurora-scan-paths over FTP.
    in-out property <bool> fetching-aurora-paths: false;
    // True once a fetch has completed at least once (to tell an empty
    // result apart from the initial "not fetched yet" state).
    in-out property <bool> aurora-paths-loaded: false;
    // Non-empty when the last fetch failed: shown in the card instead of a
    // notification.
    in-out property <string> aurora-paths-error;
    // True while the "how to add Aurora scan paths" help modal is shown.
    in-out property <bool> showing-aurora-help: false;

    // Folders this app installs/scans on the console (from .txbm.json), each
    // flagged with whether Aurora is configured to scan it. Filled by the same
    // fetch as aurora-scan-paths.
    in-out property <[DisplayedStoragePath]> app-storage-paths;
    // True when at least one app storage path is not covered by Aurora.
    in-out property <bool> storage-has-uncovered: false;
    // True when the Aurora coverage comparison applies (FTP console). False for
    // a local drive, where storage paths are only listed.
    in-out property <bool> storage-aurora-compared: false;

    // True while the BadAvatar USB-key drive-picker modal is shown.
    in-out property <bool> selecting-badavatar-target: false;

    // BadAvatar USB-key creation (Toolbox), independent of the target.
    in-out property <DisplayedBadAvatarConfig> badavatar;
    // True while a BadAvatar key is being created.
    in-out property <bool> creating-badavatar: false;
    // Non-empty while the destination-confirmation modal is shown, holding
    // the path picked for the BadAvatar key.
    in-out property <string> badavatar-pending-path: "";
}
